DEEPSEEK_API_KEY=
BRAVE_API_KEY=
UNSTRUCTURED_API_KEY=
RESPONSES_API_KEY=

CODESEEQ_MODEL=deepseek-v4-flash
CODESEEQ_THINKING=false
CODESEEQ_APPROVAL_POLICY=on-request
CODESEEQ_SANDBOX_MODE=workspace-write
CODESEEQ_YOLO=false

# Podman is preferred. Set CONTAINER=docker only when Docker is the intended runtime.
CONTAINER=podman
IMAGE=codeseeq:dev
CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true
CODESEEQ_RUNTIME_MODE=host

# --- Per-model endpoints & sampling --------------------------------------
# Generic provider base URL fallbacks (lowest-priority default override).
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=
# CODESEEQ_BASE_URL=
# DEEPSEEK_CHAT_URL=

# qwibus local gateway models (no API key required).
# CODESEEQ_QWIBUS_QWIKK_BASE_URL=http://127.0.0.1:1337
# CODESEEQ_QWIBUS_QWIKK_CHAT_URL=http://127.0.0.1:1337/v1/chat/completions
# CODESEEQ_QWIBUS_QWIKK_TEMPERATURE=0.4
# CODESEEQ_QWIBUS_QWIKK_TOP_P=0.92
# CODESEEQ_QWIBUS_QWIKK_TOP_K=20
# CODESEEQ_QWIBUS_QWIKK_MAX_OUTPUT_TOKENS=4096
# CODESEEQ_QWIBUS_QWIKK_TIMEOUT_SECONDS=60
# CODESEEQ_QWIBUS_QWIKK_ENABLE_THINKING=false
# CODESEEQ_QWIBUS_QWIKK_SYSTEM_PROMPT=

# CODESEEQ_QWIBUS_QMPLX_BASE_URL=http://127.0.0.1:1337
# CODESEEQ_QWIBUS_QMPLX_CHAT_URL=http://127.0.0.1:1337/v1/chat/completions
# CODESEEQ_QWIBUS_QMPLX_TEMPERATURE=0.6
# CODESEEQ_QWIBUS_QMPLX_TOP_P=0.95
# CODESEEQ_QWIBUS_QMPLX_TOP_K=20
# CODESEEQ_QWIBUS_QMPLX_MAX_OUTPUT_TOKENS=8192
# CODESEEQ_QWIBUS_QMPLX_TIMEOUT_SECONDS=600
# CODESEEQ_QWIBUS_QMPLX_ENABLE_THINKING=true
# CODESEEQ_QWIBUS_QMPLX_SYSTEM_PROMPT=
