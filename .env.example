# CodeSeeq environment template.
# ---------------------------------------------------------------
# Every setting below can also be supplied via a JSON config file
# (keys are the literal environment-variable names). Precedence is
# always: environment variable > JSON config > built-in default.
#
# JSON config path: CODESEEQ_CONFIG_JSON (else ~/.config/codeseeq/config.json
# on the host, or /home/codeseeq/.config/codeseeq/config.json in a container).
# ---------------------------------------------------------------

# API keys
# Configure interactively with: codeseeq config
##DEEPSEEK_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=
#GROK_API_KEY=
#BRAVE_API_KEY=
#UNSTRUCTURED_API_KEY=
#RESPONSES_API_KEY=
#VENICE_API_KEY=
## Optional bearer token for local OpenAI-compatible gateways (e.g. a local
## vLLM with auth). Leave empty for keyless gateways (Ollama, LM Studio, ...).
#LOCAL_API_KEY=

# Core model / approval / sandbox
# CODESEEQ_MODEL accepts deepseek@..., anthropic@..., google@..., grok@...,
# venice@..., local@<model> and chatgpt@<model> slugs (set via `codeseeq
# config`). The chatgpt provider signs in with a ChatGPT Plus/Pro/Team account
# (no API key) - see the "ChatGPT account sign-in" section below.
CODESEEQ_MODEL=deepseek-v4-flash
# CODESEEQ_PROVIDER=deepseek   # optional explicit provider override
CODESEEQ_THINKING=false
# DeepSeek reasoning effort (low | high | max; default high). Ignored for
# non-DeepSeek providers. Override per-run with: codeseeq -R max
# CODESEEQ_REASONING_EFFORT=high
CODESEEQ_APPROVAL_POLICY=on-request
CODESEEQ_SANDBOX_MODE=workspace-write
CODESEEQ_YOLO=false

# Container runtime
# Podman is preferred. Set CONTAINER=docker only when Docker is the intended runtime.
CONTAINER=podman
IMAGE=codeseeq:dev
# Workspace permission alignment: by default CodeSeeq runs the container user
# mapped to your host user so the bind-mounted workspace is writable.
#   podman: --userns=keep-id (default). Override or disable:
#     CODESEEQ_PODMAN_USERNS=keep-id   # explicit
#     CODESEEQ_PODMAN_USERNS=          # disable userns mapping
#   docker: --user <host-uid>:<host-gid> (default for non-root hosts).
#     CODESEEQ_DOCKER_USER=            # disable --user mapping
#     CODESEEQ_DOCKER_USER=1000:1000   # explicit uid:gid
CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true
CODESEEQ_RUNTIME_MODE=host

# Bridge port selection / lifecycle
CODESEEQ_BRIDGE_MODE=auto             # auto | process | container | external
CODESEEQ_BRIDGE_HOST=127.0.0.1
# CODESEEQ_BRIDGE_PORT=                 # fixed port override (omit for auto-select)
# CODESEEQ_BRIDGE_PORT_FILE=           # bridge writes the chosen port here
CODESEEQ_BRIDGE_CONTAINER_PORT=8080  # internal port used inside the bridge container
# CODESEEQ_BRIDGE_BASE_URL=
CODESEEQ_OPENRESPONSES_PORT=8080     # auto-select starting port
# CODESEEQ_OPENRESPONSES_PORT_SCAN_LIMIT=100
# CODESEEQ_BRIDGE_REUSE=0
# CODESEEQ_BRIDGE_STARTUP_TIMEOUT=10

# Streaming
CODESEEQ_STREAM=true
# CODESEEQ_STREAM_IDLE_TIMEOUT_MS=600000  # enforced by the bridge (idle read timeout)

# Codex CLI stderr noise (host runtime)
# Modern Codex CLI builds can print a benign teardown error at the end of a
# one-shot run:
#   ERROR codex_core::session: failed to record rollout items: thread <uuid> not found
# CodeSeeq filters that line out of `codeseeq run` / piped passthrough stderr by
# default. Set to true to keep the raw upstream line visible.
# CODESEEQ_KEEP_CODEX_ROLLOUT_ERRORS=false

# --- Per-model endpoints & sampling --------------------------------------
# Generic provider base URL fallbacks (lowest-priority default override).
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=
# CODESEEQ_BASE_URL=
# DEEPSEEK_CHAT_URL=

# qwibus local gateway models (no API key required).
# CODESEEQ_QWIBUS_QWIKK_BASE_URL=http://127.0.0.1:1337
# CODESEEQ_QWIBUS_QWIKK_CHAT_URL=http://127.0.0.1:1337/v1/chat/completions
# CODESEEQ_QWIBUS_QWIKK_TEMPERATURE=0.4
# CODESEEQ_QWIBUS_QWIKK_TOP_P=0.92
# CODESEEQ_QWIBUS_QWIKK_TOP_K=20
# CODESEEQ_QWIBUS_QWIKK_MAX_OUTPUT_TOKENS=4096
# CODESEEQ_QWIBUS_QWIKK_TIMEOUT_SECONDS=60
# CODESEEQ_QWIBUS_QWIKK_ENABLE_THINKING=false
# CODESEEQ_QWIBUS_QWIKK_SYSTEM_PROMPT=

# CODESEEQ_QWIBUS_QMPLX_BASE_URL=http://127.0.0.1:1337
# CODESEEQ_QWIBUS_QMPLX_CHAT_URL=http://127.0.0.1:1337/v1/chat/completions
# CODESEEQ_QWIBUS_QMPLX_TEMPERATURE=0.6
# CODESEEQ_QWIBUS_QMPLX_TOP_P=0.95
# CODESEEQ_QWIBUS_QMPLX_TOP_K=20
# CODESEEQ_QWIBUS_QMPLX_MAX_OUTPUT_TOKENS=8192
# CODESEEQ_QWIBUS_QMPLX_TIMEOUT_SECONDS=600
# CODESEEQ_QWIBUS_QMPLX_ENABLE_THINKING=true
# CODESEEQ_QWIBUS_QMPLX_SYSTEM_PROMPT=

# DeepSeek per-model overrides (same CODESEEQ_<MODEL>_<SUFFIX> scheme).
CODESEEQ_DEEPSEEK_V4_FLASH_BASE_URL=https://api.deepseek.com
CODESEEQ_DEEPSEEK_V4_FLASH_CHAT_URL=https://api.deepseek.com/chat/completions
# CODESEEQ_DEEPSEEK_V4_FLASH_TEMPERATURE=
# CODESEEQ_DEEPSEEK_V4_FLASH_TOP_P=
# CODESEEQ_DEEPSEEK_V4_FLASH_TOP_K=
# CODESEEQ_DEEPSEEK_V4_FLASH_MAX_OUTPUT_TOKENS=
# CODESEEQ_DEEPSEEK_V4_FLASH_TIMEOUT_SECONDS=
# CODESEEQ_DEEPSEEK_V4_FLASH_ENABLE_THINKING=
# CODESEEQ_DEEPSEEK_V4_FLASH_SYSTEM_PROMPT=

# Provider base URL fallbacks (re-point the chat endpoint; anthropic appends
# /v1/messages, the other providers append /chat/completions).
# ANTHROPIC_BASE_URL=
# GOOGLE_BASE_URL=
# GROK_BASE_URL=
# VENICE_BASE_URL=
# LOCAL_BASE_URL=
# LOCAL_API_KEY=  (optional; see the API-keys section above)

# --- GGUF local-model (llama.cpp) -----------------------------------------
# Select a model by its full .gguf path: CODESEEQ_MODEL=/path/to/model.gguf
# (or --model /path/to/model.gguf / gguf@/path/to/model.gguf). The bridge
# launches llama-server for you; no API key is required.
# CODESEEQ_GGUF_LLAMA_SERVER_PATH=/path/to/llama-server
# The tuning knobs below map 1:1 to llama-server flags and can be set via
# env var or JSON config key (same name):
#   CODESEEQ_GGUF_CONTEXT_WINDOW -> -c      (context size, e.g. 131072)
#   CODESEEQ_GGUF_N_GPU_LAYERS  -> -ngl    (GPU layers, e.g. all / 99 / 0)
#   CODESEEQ_GGUF_PARALLEL      -> -np     (parallel slots, e.g. 1)
#   CODESEEQ_GGUF_PORT          -> --port  (fixed loopback port, e.g. 8888)
# CODESEEQ_GGUF_CONTEXT_WINDOW=8192
# CODESEEQ_GGUF_MAX_OUTPUT_TOKENS=2048
# Per-model overrides live in config/gguf-models.json (host) or
# /etc/codeseeq/gguf-models.json (container); set CODESEEQ_GGUF_MODELS_JSON to
# use a custom file. Key the model by path (absolute or ~/), basename, or
# basename without .gguf; per-model values win over the env vars above:
# CODESEEQ_GGUF_MODELS_JSON=/path/to/gguf-models.json
# CODESEEQ_GGUF_N_GPU_LAYERS=0
# CODESEEQ_GGUF_THREADS=
# CODESEEQ_GGUF_PARALLEL=1
# CODESEEQ_GGUF_PORT=         # fixed port override (omit to auto-select a free port)
# CODESEEQ_GGUF_TIMEOUT_SECONDS=600
# CODESEEQ_GGUF_STARTUP_TIMEOUT_SECONDS=300
# CODESEEQ_GGUF_ENABLE_THINKING=false
# GGUF_BASE_URL=         # advanced: reuse an already-running GGUF server
# GGUF_API_KEY=          # optional --api-key for the local server

# --- MLX local-model (Apple MLX / mlx-lm) ---------------------------------
# Select a local MLX model directory: CODESEEQ_MODEL=mlx@/path/to/model-dir
# (or --model mlx@/path/to/model-dir). The directory must contain an MLX
# conversion (config.json + *.safetensors + tokenizer files). The bridge
# launches `python -m mlx_lm.server` for you; no API key is required. The
# model's own config.json (max_position_embeddings / model_max_length, incl.
# nested text_config) is read automatically for the context window.
# CODESEEQ_MLX_PYTHON=          # interpreter with mlx_lm (default: python3)
# CODESEEQ_MLX_PORT=            # fixed loopback port for mlx_lm.server
# CODESEEQ_MLX_CONTEXT_WINDOW=  # override (default: from the model config.json)
# CODESEEQ_MLX_MAX_OUTPUT_TOKENS=2048
# CODESEEQ_MLX_TIMEOUT_SECONDS=600
# CODESEEQ_MLX_STARTUP_TIMEOUT_SECONDS=600
# CODESEEQ_MLX_ENABLE_THINKING=false
# CODESEEQ_MLX_SERVER_ARGS=     # extra flags, e.g. --adapter-path ... --cache-size ...
# CODESEEQ_TEMPERATURE=0.0      # generic sampling fallback (mlx/gguf)
# Per-model overrides live in config/mlx-models.json (host) or
# /etc/codeseeq/mlx-models.json (container); set CODESEEQ_MLX_MODELS_JSON to
# use a custom file. Key the model by path (absolute or ~/), basename, or
# trailing component; per-model values win over the env vars above.
# CODESEEQ_MLX_MODELS_JSON=/path/to/mlx-models.json
# Reuse an already-running OpenAI-compatible MLX server instead of spawning
# one (base URL may end with /v1; a generic loopback CODESEEQ_BASE_URL also
# works for mlx, non-loopback generic base URLs are ignored for mlx):
# MLX_BASE_URL=http://127.0.0.1:8888/v1
# CODESEEQ_MLX_BASE_URL=http://127.0.0.1:8888
# MLX_API_KEY=          # optional bearer token for the local server


# --- ChatGPT account sign-in (chatgpt provider, no API key) -----------------
# Use your OpenAI ChatGPT Plus / Pro / Team subscription instead of any API
# key. CodeSeeq bypasses the local bridge and drives upstream Codex natively:
#   CODESEEQ_MODEL=chatgpt@gpt-5-codex
#   CODESEEQ_PROVIDER=chatgpt
# then sign in once with:  codeseeq login   (choose "Sign in with ChatGPT").
# The ChatGPT OAuth session is stored in <workdir>/.codeseeq/auth.json
# (CODEX_HOME) and requests go to https://chatgpt.com/backend-api/codex.
# Host runtime is forced automatically (no container, no bridge). Available
# ChatGPT Codex model ids (pick any in the config wizard):
#   gpt-5-codex, gpt-5.1-codex, gpt-5.2-codex, gpt-5.3-codex
# Log out with:  codeseeq logout
# Privacy note: upstream `login`/`logout` are blocked for all providers except
# chatgpt (where they are the sign-in flow); every other upstream
# OpenAI/ChatGPT command stays blocked unless you set:
# CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true

# New provider per-model overrides use the model name only (the bridge strips
# the "provider@" slug prefix): e.g. for anthropic@claude-sonnet-4 ->
# CODESEEQ_CLAUDE_SONNET_4_BASE_URL, google@gemini-2.5-pro ->
# CODESEEQ_GEMINI_2_5_PRO_BASE_URL, grok@grok-4 ->
# CODESEEQ_GROK_4_BASE_URL, venice@venice-qwen-3-32b ->
# CODESEEQ_VENICE_QWEN_3_32B_BASE_URL, local@llama-4-maverick ->
# CODESEEQ_LLAMA_4_MAVERICK_BASE_URL (the provider prefix is stripped the
# same way as for hosted providers).
# Each accepts the same _BASE_URL/_CHAT_URL/_TEMPERATURE/_TOP_P/_TOP_K/
# _MAX_OUTPUT_TOKENS/_TIMEOUT_SECONDS/_ENABLE_THINKING/_SYSTEM_PROMPT suffixes.
