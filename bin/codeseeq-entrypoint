#!/usr/bin/env bash
set -Eeuo pipefail

log() {
  printf '[codeseeq] %s\n' "$*" >&2
}

warn() {
  printf '[codeseeq:warn] %s\n' "$*" >&2
}

die() {
  printf '[codeseeq:error] %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command missing: $1"
}

bool_normalize() {
  local v="${1:-}"
  local vl
  vl="$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')"
  case "$vl" in
    1|true|yes|on) printf 'true' ;;
    0|false|no|off) printf 'false' ;;
    *) printf '%s' "$v" ;;
  esac
}

key_state() {
  local v="${1:-}"
  if [[ -n "$v" ]]; then
    printf 'present'
  else
    printf 'missing'
  fi
}

# ---------------------------------------------------------------------------
# JSON configuration fallback (env vars override JSON config at all times)
# ---------------------------------------------------------------------------
config_json_path() {
  printf '%s' "${CODESEEQ_CONFIG_JSON:-${CODESEEQ_CONFIG_HOME:-${XDG_CONFIG_HOME:-/home/codeseeq/.config}/codeseeq}/config.json}"
}

load_config_json() {
  local path
  path="$(config_json_path)"
  [[ -n "$path" && -f "$path" ]] || return 0

  local parsed=""
  if command -v python3 >/dev/null 2>&1; then
    parsed="$(python3 - "$path" 2>/dev/null <<'INNERCFG'
import json, os, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)
allowlist = {
    "DEEPSEEK_API_KEY", "ANTHROPIC_API_KEY", "GOOGLE_API_KEY",
    "GROK_API_KEY", "BRAVE_API_KEY", "UNSTRUCTURED_API_KEY",
    "RESPONSES_API_KEY", "VENICE_API_KEY", "LOCAL_API_KEY",
    "CONTAINER", "IMAGE",
    "OPENAI_BASE_URL", "DEEPSEEK_BASE_URL", "DEEPSEEK_CHAT_URL",
    "ANTHROPIC_BASE_URL", "GOOGLE_BASE_URL", "GROK_BASE_URL",
    "VENICE_BASE_URL", "LOCAL_BASE_URL",
    "UNSTRUCTURED_API_URL", "QWIBUS_NO_API_KEY",
}
for k, v in data.items():
    if not isinstance(k, str) or not k:
        continue
    if not (k.startswith("CODESEEQ_") or k in allowlist):
        continue
    # Environment always wins over JSON config.
    if os.environ.get(k) not in (None, ""):
        continue
    if isinstance(v, bool):
        sys.stdout.write("%s=%s\n" % (k, "true" if v else "false"))
    elif isinstance(v, (str, int, float)):
        sys.stdout.write("%s=%s\n" % (k, v))
INNERCFG
)" || parsed=""
  elif command -v jq >/dev/null 2>&1; then
    parsed="$(jq -r 'to_entries[] | select((.key|startswith("CODESEEQ_")) or (.key|IN("DEEPSEEK_API_KEY","ANTHROPIC_API_KEY","GOOGLE_API_KEY","GROK_API_KEY","BRAVE_API_KEY","UNSTRUCTURED_API_KEY","RESPONSES_API_KEY","VENICE_API_KEY","LOCAL_API_KEY","CONTAINER","IMAGE","OPENAI_BASE_URL","DEEPSEEK_BASE_URL","DEEPSEEK_CHAT_URL","ANTHROPIC_BASE_URL","GOOGLE_BASE_URL","GROK_BASE_URL","VENICE_BASE_URL","LOCAL_BASE_URL","UNSTRUCTURED_API_URL","QWIBUS_NO_API_KEY"))) | select(.value != null) | "\(.key)=\(.value)"' "$path" 2>/dev/null || true)"
  else
    warn "CODESEEQ_CONFIG_JSON/JSON config configured but neither python3 nor jq is available; skipping JSON config"
    return 0
  fi

  if [[ -z "$parsed" ]]; then
    return 0
  fi

  local line k v
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    k="${line%%=*}"
    v="${line#*=}"
    [[ -n "$k" ]] || continue
    if [[ -z "${!k+x}" ]] || [[ -z "${!k:-}" ]]; then
      export "$k=$v"
    fi
  done <<< "$parsed"
  return 0
}

toml_quote_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    die "system prompt file not found: $path"
  fi
  if [[ ! -r "$path" ]]; then
    die "system prompt file is not readable by $(id -u): $path"
  fi
  if command -v jq >/dev/null 2>&1; then
    jq -Rs . < "$path"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' < "$path"
  else
    die "jq or python3 is required to quote system prompt text for Codex config"
  fi
}

system_prompt_present() {
  [[ -f "$CODESEEQ_SYSTEM_PROMPT_FILE" && -s "$CODESEEQ_SYSTEM_PROMPT_FILE" ]]
}

system_prompt_state() {
  if system_prompt_present; then
    printf 'present'
  else
    printf 'missing'
  fi
}

system_prompt_bytes() {
  if [[ -f "$CODESEEQ_SYSTEM_PROMPT_FILE" ]]; then
    wc -c < "$CODESEEQ_SYSTEM_PROMPT_FILE" | tr -d '[:space:]'
  else
    printf '0'
  fi
}

system_prompt_lines() {
  if [[ -f "$CODESEEQ_SYSTEM_PROMPT_FILE" ]]; then
    awk 'END { print NR }' "$CODESEEQ_SYSTEM_PROMPT_FILE"
  else
    printf '0'
  fi
}

print_workspace_banner() {
  if [[ "$(bool_normalize "${CODESEEQ_WORKSPACE_BANNER:-true}")" == "false" ]]; then
    return 0
  fi
  if [[ -n "${CODESEEQ_HOST_WORKDIR:-}" ]]; then
    {
      printf 'CodeSeeq workspace:\n'
      printf '  host: %s\n' "$CODESEEQ_HOST_WORKDIR"
      printf '  container: %s\n' "$CODESEEQ_WORKDIR"
    } >&2
  fi
}

load_config_json

if [[ -n "${CODESEEQ_SYSTEM_PROMPT_FILE+x}" ]]; then
  CODESEEQ_SYSTEM_PROMPT_FILE_EXPLICIT=true
else
  CODESEEQ_SYSTEM_PROMPT_FILE_EXPLICIT=false
fi

: "${CODESEEQ_MODEL:=deepseek-v4-flash}"
: "${CODESEEQ_THINKING:=}"
: "${CODESEEQ_REASONING_EFFORT:=}"
: "${CODESEEQ_OPENRESPONSES_HOST:=127.0.0.1}"
: "${CODESEEQ_OPENRESPONSES_PORT:=8080}"
: "${CODESEEQ_OPENRESPONSES_URL:=http://${CODESEEQ_OPENRESPONSES_HOST}:${CODESEEQ_OPENRESPONSES_PORT}/v1}"
: "${CODESEEQ_OPENRESPONSES_CMD:=/usr/local/bin/codeseeq-bridge.py}"
: "${CODESEEQ_CODEX_HOME:=/home/codeseeq/.codeseeq}"
: "${CODESEEQ_WORKDIR:=/workspace}"
: "${CODESEEQ_APPROVAL_POLICY:=on-request}"
: "${CODESEEQ_SANDBOX_MODE:=workspace-write}"
: "${CODESEEQ_STREAM:=true}"
: "${CODESEEQ_STREAM_IDLE_TIMEOUT_MS:=600000}"
: "${CODESEEQ_REQUEST_MAX_RETRIES:=2}"
: "${CODESEEQ_CONTEXT_WINDOW:=1000000}"
: "${CODESEEQ_MAX_OUTPUT_TOKENS:=384000}"
: "${CODESEEQ_RUNTIME_DIR:=/run/codeseeq}"
: "${CODESEEQ_LOG_DIR:=/var/log/codeseeq}"
: "${CODESEEQ_OPENRESPONSES_START_TIMEOUT_SECONDS:=45}"
: "${CODESEEQ_RUNTIME_MODE:=auto}"
: "${CODESEEQ_BRIDGE_MODE:=auto}"
: "${CODESEEQ_YOLO:=false}"
: "${CODESEEQ_HOST_WORKDIR:=}"

# --- Image backend configuration ---
: "${CODESEEQ_IMAGE_BACKEND:=none}"
: "${CODESEEQ_VENICE_IMAGE_MODEL:=z-image-turbo}"
: "${CODESEEQ_VENICE_IMAGE_ASPECT_RATIO:=1:1}"
: "${CODESEEQ_VENICE_IMAGE_RESOLUTION:=1K}"
: "${CODESEEQ_VENICE_IMAGE_FORMAT:=webp}"
: "${CODESEEQ_VENICE_IMAGE_VARIANTS:=1}"
: "${CODESEEQ_VENICE_IMAGE_SAFE_MODE:=true}"
: "${CODESEEQ_VENICE_IMAGE_HIDE_WATERMARK:=false}"
: "${CODESEEQ_VENICE_IMAGE_SEED:=0}"
: "${CODESEEQ_VENICE_IMAGE_RETURN_BINARY:=false}"

# Auto-detect: if VENICE_API_KEY is set and backend is still "none", switch to venice
if [[ "${CODESEEQ_IMAGE_BACKEND}" == "none" && -n "${VENICE_API_KEY:-}" ]]; then
  CODESEEQ_IMAGE_BACKEND=venice
  log "auto-detected VENICE_API_KEY; image backend set to venice"
fi
: "${CODESEEQ_WORKSPACE_BANNER:=true}"
: "${CODESEEQ_CONFIG_HOME:=${XDG_CONFIG_HOME:-/home/codeseeq/.config}/codeseeq}"
: "${CODESEEQ_SYSTEM_PROMPT_FILE:=${CODESEEQ_CONFIG_HOME}/system-prompt.md}"
: "${CODESEEQ_SYSTEM_PROMPT_INJECTION:=codex-config-developer_instructions}"

export CODESEEQ_MODEL CODESEEQ_THINKING CODESEEQ_REASONING_EFFORT CODESEEQ_OPENRESPONSES_HOST CODESEEQ_OPENRESPONSES_PORT
export CODESEEQ_IMAGE_BACKEND CODESEEQ_VENICE_IMAGE_MODEL
export CODESEEQ_VENICE_IMAGE_ASPECT_RATIO CODESEEQ_VENICE_IMAGE_RESOLUTION
export CODESEEQ_VENICE_IMAGE_FORMAT CODESEEQ_VENICE_IMAGE_VARIANTS
export CODESEEQ_VENICE_IMAGE_SAFE_MODE CODESEEQ_VENICE_IMAGE_HIDE_WATERMARK
export CODESEEQ_VENICE_IMAGE_SEED CODESEEQ_VENICE_IMAGE_RETURN_BINARY
export CODESEEQ_OPENRESPONSES_URL CODESEEQ_OPENRESPONSES_CMD CODESEEQ_CODEX_HOME CODESEEQ_WORKDIR
export CODESEEQ_APPROVAL_POLICY CODESEEQ_SANDBOX_MODE CODESEEQ_STREAM CODESEEQ_STREAM_IDLE_TIMEOUT_MS
export CODESEEQ_REQUEST_MAX_RETRIES CODESEEQ_CONTEXT_WINDOW CODESEEQ_MAX_OUTPUT_TOKENS CODESEEQ_YOLO
export CODESEEQ_HOST_WORKDIR CODESEEQ_WORKSPACE_BANNER CODESEEQ_CONFIG_HOME CODESEEQ_SYSTEM_PROMPT_FILE
export CODESEEQ_SYSTEM_PROMPT_INJECTION

mkdir -p "$CODESEEQ_CODEX_HOME" "$CODESEEQ_WORKDIR" "$CODESEEQ_RUNTIME_DIR" "$CODESEEQ_LOG_DIR"
CODESEEQ_PID_FILE="$CODESEEQ_RUNTIME_DIR/openresponses.pid"
CODESEEQ_LOG_FILE="$CODESEEQ_LOG_DIR/openresponses.log"

resolve_system_prompt_file() {
  local configured="${CODESEEQ_SYSTEM_PROMPT_FILE:-}"
  local candidate
  local candidates=()

  [[ -n "$configured" ]] && candidates+=("$configured")
  if [[ "$CODESEEQ_SYSTEM_PROMPT_FILE_EXPLICIT" != "true" ]]; then
    candidates+=(
      "${CODESEEQ_WORKDIR}/.codeseeq/system-prompt.md"
      "${CODESEEQ_CODEX_HOME}/system-prompt.md"
    )
  fi

  for candidate in "${candidates[@]}"; do
    if [[ -f "$candidate" && -s "$candidate" ]]; then
      if [[ -r "$candidate" ]]; then
        CODESEEQ_SYSTEM_PROMPT_FILE="$candidate"
        export CODESEEQ_SYSTEM_PROMPT_FILE
        return 0
      fi
      warn "system prompt ${candidate} exists but is not readable by $(id -u); falling back to bundled default"
    fi
  done

  # Fall back to the bundled default system prompt so a fresh install
  # reports "present" and Codex always receives developer_instructions even
  # before the user configures a custom prompt.
  local bundled="${CODESEEQ_DEFAULT_SYSTEM_PROMPT_FILE:-/etc/codeseeq/default-system-prompt.md}"
  if [[ -f "$bundled" && -s "$bundled" ]]; then
    CODESEEQ_SYSTEM_PROMPT_FILE="$bundled"
    export CODESEEQ_SYSTEM_PROMPT_FILE
    return 0
  fi

  if [[ -n "$configured" ]]; then
    CODESEEQ_SYSTEM_PROMPT_FILE="$configured"
  else
    CODESEEQ_SYSTEM_PROMPT_FILE="${CODESEEQ_CONFIG_HOME}/system-prompt.md"
  fi
  export CODESEEQ_SYSTEM_PROMPT_FILE
}

resolve_system_prompt_file

# Check workspace writability early.
if [[ ! -w "$CODESEEQ_WORKDIR" ]]; then
  warn "workspace ${CODESEEQ_WORKDIR} is not writable by $(id -u). host volume mapping might have permission issues."
  # If running as root, try to fix ownership so the workspace user can write.
  if [[ "$(id -u)" == "0" && -n "${CODESEEQ_WORKSPACE_UID:-}" ]]; then
    chown -R "${CODESEEQ_WORKSPACE_UID}:${CODESEEQ_WORKSPACE_GID:-${CODESEEQ_WORKSPACE_UID}}" "$CODESEEQ_WORKDIR" 2>/dev/null && \
      log "chowned ${CODESEEQ_WORKDIR} to ${CODESEEQ_WORKSPACE_UID}" || \
      warn "could not chown ${CODESEEQ_WORKDIR}"
  fi
  # Attempt a tiny test write.
  if ! touch "$CODESEEQ_WORKDIR/.codeseeq-write-test" 2>/dev/null; then
    warn "write test failed in ${CODESEEQ_WORKDIR}"
    warn "fix: launch codeseeq with CODESEEQ_PODMAN_USERNS=keep-id (podman) or CODESEEQ_DOCKER_USER=\$(id -u):\$(id -g) (docker), or chown/chmod the host workspace directory"
  else
    rm -f "$CODESEEQ_WORKDIR/.codeseeq-write-test"
    log "workspace is writable despite warning"
  fi
else
  log "workspace ${CODESEEQ_WORKDIR} is writable"
fi

MODEL_INPUT="$CODESEEQ_MODEL"
PROVIDER_MODEL=""
THINKING_EFFECTIVE=""

# --- ChatGPT account sign-in (native upstream Codex auth, no API key) -------
# The "chatgpt" provider uses upstream Codex's own ChatGPT account login
# (Plus / Pro / Team). CodeSeeq skips the local bridge entirely and generates
# a config whose model_provider is upstream's built-in "openai" provider
# (requires_openai_auth=true), so the ChatGPT OAuth tokens stored in
# CODEX_HOME/auth.json are used and requests go to the ChatGPT backend
# (https://chatgpt.com/backend-api/codex). No OPENAI_API_KEY or any other API
# key is required. Login flow: `codeseeq login` -> "Sign in with ChatGPT".

is_chatgpt_model() {
  local model="${1:-${CODESEEQ_MODEL:-${PROVIDER_MODEL:-}}}"
  [[ "${CODESEEQ_PROVIDER:-}" == "chatgpt" ]] && return 0
  local lower
  lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower" == chatgpt@* ]] && return 0
  return 1
}

# Check whether the model actually requested for this invocation is chatgpt.
# `is_chatgpt_model` alone only sees the env/config value; the CLI may override
# it with -m/--model in any argv position (including after a `run` command),
# so scan the remaining args for a chatgpt model flag as well.
requested_chatgpt_model() {
  is_chatgpt_model && return 0
  local arg value
  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      -m|--model)
        [[ $# -ge 2 ]] || return 1
        value="$2"
        is_chatgpt_model "$value" && return 0
        shift 2
        ;;
      --model=*)
        value="${arg#--model=}"
        is_chatgpt_model "$value" && return 0
        shift
        ;;
      --)
        # Everything after `--` is literal prompt text, never a model flag.
        return 1
        ;;
      *)
        shift
        ;;
    esac
  done
  return 1
}

# Print the upstream OpenAI model id for the chatgpt provider (chatgpt@ prefix
# stripped). Dies on a model that clearly is not an OpenAI ChatGPT model.
chatgpt_upstream_model() {
  local slug="${PROVIDER_MODEL:-${CODESEEQ_MODEL:-}}"
  local upstream=""
  case "$slug" in
    chatgpt@*) upstream="${slug#chatgpt@}" ;;
    *)
      if [[ "${CODESEEQ_PROVIDER:-}" == "chatgpt" ]]; then
        if [[ "$slug" == *@* ]]; then
          upstream="${slug#*@}"
        else
          upstream="$slug"
        fi
      fi
      ;;
  esac
  [[ -n "$upstream" ]] || die "chatgpt provider requires a model, e.g. codeseeq -m chatgpt@gpt-5-codex"
  case "$upstream" in
    deepseek-v4-*|qwibus-*|claude-*|gemini-*|grok-*|venice-*|local)
      die "unsupported ChatGPT model: ${upstream}. Use an OpenAI ChatGPT model id such as gpt-5-codex (run: codeseeq config)"
      ;;
  esac
  printf '%s\n' "$upstream"
}

chatgpt_auth_file() {
  printf '%s\n' "${1:-}/auth.json"
}

# True when the Codex auth.json under <dir> holds a (non-expired) ChatGPT
# OAuth session - the exact state upstream Codex needs for requires_openai_auth.
chatgpt_has_session() {
  local dir="${1:-}"
  local auth
  auth="$(chatgpt_auth_file "$dir")"
  [[ -f "$auth" ]] || return 1
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$auth" <<'PYCHATGPT'
import json, sys, time
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
tokens = data.get("tokens")
if not isinstance(tokens, dict) or not tokens.get("access_token"):
    sys.exit(1)
expires = tokens.get("expires_at")
if isinstance(expires, (int, float)) and expires > 0 and expires < time.time():
    sys.exit(1)
sys.exit(0)
PYCHATGPT
    return $?
  fi
  grep -q '"tokens"' "$auth" 2>/dev/null
}

chatgpt_login_required_check() {
  local dir="${1:-${HOST_CODEX_HOME:-${CODEX_HOME:-}}}"
  [[ -n "$dir" ]] || die "internal error: CODEX_HOME not known for ChatGPT auth check"
  if chatgpt_has_session "$dir"; then
    return 0
  fi
  local auth
  auth="$(chatgpt_auth_file "$dir")"
  if [[ -f "$auth" ]] && grep -q 'OPENAI_API_KEY' "$auth" 2>/dev/null; then
    die "chatgpt provider requires a ChatGPT account session (Plus/Pro/Team), not an API key. Run: codeseeq logout && codeseeq login  and choose 'Sign in with ChatGPT'"
  fi
  die "ChatGPT account sign-in required for the chatgpt provider (no API key needed). Run: codeseeq login  and choose 'Sign in with ChatGPT' (session stored under ${dir})"
}


normalize_model() {
  local model="$1"
  local thinking_override="${2:-}"
  local alias_thinking="false"

  if [[ "$model" == deepseek/deepseek-v4-* ]]; then
    model="${model/deepseek\//deepseek@}"
  fi
  if [[ "$model" == qwibus/qwibus-* ]]; then
    model="${model/qwibus\//qwibus@}"
  fi

  # ChatGPT account sign-in provider (native upstream Codex/OpenAI auth):
  # with CODESEEQ_PROVIDER=chatgpt a bare upstream model becomes
  # chatgpt@<model> so the native provider resolves a clean model id.
  if [[ "${CODESEEQ_PROVIDER:-}" == "chatgpt" && "$model" != *@* ]]; then
    model="chatgpt@${model}"
  fi

  case "$model" in
    deepseek-v4-flash)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="false"
      ;;
    deepseek-v4-flash-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="true"
      ;;
    deepseek-v4-pro)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="false"
      ;;
    deepseek-v4-pro-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="true"
      ;;
    deepseek@deepseek-v4-flash)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="false"
      ;;
    deepseek@deepseek-v4-flash-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="true"
      ;;
    deepseek@deepseek-v4-pro)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="false"
      ;;
    deepseek@deepseek-v4-pro-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="true"
      ;;
    qwibus-qwikk)
      PROVIDER_MODEL="qwibus@qwibus-qwikk"
      alias_thinking="false"
      ;;
    qwibus-qmplx)
      PROVIDER_MODEL="qwibus@qwibus-qmplx"
      alias_thinking="true"
      ;;
    qwibus@qwibus-qwikk)
      PROVIDER_MODEL="qwibus@qwibus-qwikk"
      alias_thinking="false"
      ;;
    qwibus@qwibus-qmplx)
      PROVIDER_MODEL="qwibus@qwibus-qmplx"
      alias_thinking="true"
      ;;
    *)
      # GGUF local-model selection: gguf@<path> or a bare .gguf path.
      # Resolve to an absolute path now (validation happens in the bridge)
      # so Codex and the bridge always see the same canonical slug.
      local gguf_path="" gguf_lower=""
      if [[ "$model" == gguf@* ]]; then
        gguf_path="${model#gguf@}"
      else
        gguf_lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
        if [[ "$gguf_lower" == *.gguf ]]; then
          gguf_path="$model"
        fi
      fi
      if [[ -n "$gguf_path" ]]; then
        gguf_path="$(printf '%s' "$gguf_path" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -n "$gguf_path" ]] || die "gguf model path is empty"
        if command -v python3 >/dev/null 2>&1; then
          PROVIDER_MODEL="gguf@$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$gguf_path")"
        else
          case "$gguf_path" in
            /*) PROVIDER_MODEL="gguf@${gguf_path}" ;;
            ~/*) PROVIDER_MODEL="gguf@${HOME}${gguf_path#\~}" ;;
            *) PROVIDER_MODEL="gguf@$(pwd -P)/${gguf_path}" ;;
          esac
        fi
        alias_thinking="false"
        CODESEEQ_PROVIDER="gguf"
      else
        # New provider slugs: <provider>@<model> (anthropic, google, grok,
        # venice, local). A trailing "-thinking" enables thinking; local
        # accepts any manually-typed model name.
        local owner upstream
        if [[ "$model" == *@* ]]; then
          owner="${model%%@*}"
          upstream="${model#*@}"
          case "$owner" in
            anthropic|google|grok|venice|deepseek|local|chatgpt)
              [[ -n "$upstream" ]] || die "unsupported model: ${model} (empty model name after @)"
              PROVIDER_MODEL="$model"
              alias_thinking="false"
              case "$upstream" in
                *-thinking|thinking) alias_thinking="true" ;;
              esac
              ;;
            *)
              die "unsupported provider: ${owner} in model ${model}. supported providers: deepseek, qwibus, anthropic, google, grok, venice, local, gguf, mlx, chatgpt"
              ;;
          esac
        else
          die "unsupported model: ${model}. supported choices: deepseek-v4-flash, deepseek-v4-flash-thinking, deepseek-v4-pro, deepseek-v4-pro-thinking, deepseek@deepseek-v4-flash, deepseek@deepseek-v4-pro, qwibus-qwikk, qwibus-qmplx, qwibus@qwibus-qwikk, qwibus@qwibus-qmplx, chatgpt@gpt-5-codex, or <provider>@<model> with provider in anthropic, google, grok, venice, local, gguf, mlx, chatgpt"
        fi
      fi
      ;;
  esac

  if [[ -n "$thinking_override" ]]; then
    THINKING_EFFECTIVE="$(bool_normalize "$thinking_override")"
  else
    THINKING_EFFECTIVE="$alias_thinking"
  fi

  THINKING_EFFECTIVE="$(bool_normalize "$THINKING_EFFECTIVE")"
  if [[ "$THINKING_EFFECTIVE" != "true" && "$THINKING_EFFECTIVE" != "false" ]]; then
    die "invalid thinking value: ${THINKING_EFFECTIVE}"
  fi

  CODESEEQ_MODEL="$model"
  CODESEEQ_THINKING="$THINKING_EFFECTIVE"
  export CODESEEQ_MODEL CODESEEQ_THINKING
}

bridge_health() {
  curl --silent --show-error --fail --max-time 2 --connect-timeout 1 "${CODESEEQ_OPENRESPONSES_URL%/v1}/health" >/dev/null 2>&1
}

bridge_pid_running() {
  [[ -s "$CODESEEQ_PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$CODESEEQ_PID_FILE")"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

start_bridge() {
  require_cmd curl

  # Native ChatGPT account sign-in runs Codex directly against the ChatGPT
  # backend; there is no CodeSeeq bridge to start.
  if is_chatgpt_model; then
    log "chatgpt provider: skipping local bridge (native upstream Codex)"
    return 0
  fi

  if bridge_health; then
    return 0
  fi

  if bridge_pid_running; then
    sleep 1
    if bridge_health; then
      return 0
    fi
  fi

  log "starting bridge with: ${CODESEEQ_OPENRESPONSES_CMD}"
  # shellcheck disable=SC2086
  bash -lc "${CODESEEQ_OPENRESPONSES_CMD}" >"$CODESEEQ_LOG_FILE" 2>&1 &
  echo "$!" > "$CODESEEQ_PID_FILE"

  local deadline=$((SECONDS + CODESEEQ_OPENRESPONSES_START_TIMEOUT_SECONDS))
  while (( SECONDS < deadline )); do
    if bridge_health; then
      return 0
    fi
    sleep 1
  done

  warn "bridge failed to become healthy"
  if [[ -f "$CODESEEQ_LOG_FILE" ]]; then
    tail -n 60 "$CODESEEQ_LOG_FILE" >&2 || true
  fi
  return 1
}

# Merge the static Codex model catalog with the currently configured model so
# Codex accepts any model selected via `codeseeq config` (including arbitrary
# local@<model> names) inside the container, matching host-mode behavior.
# Writes to <output>; falls back to the static catalog when no merge is needed.
# ---------------------------------------------------------------------------
# Per-model GGUF configuration (config/gguf-models.json)
# ---------------------------------------------------------------------------
# GGUF models can carry their own llama-server settings (context window,
# max output tokens, GPU layers, threads, parallel slots, port, timeout,
# thinking). The per-model JSON wins over the global CODESEEQ_GGUF_* env
# vars, which win over the built-in defaults.

gguf_models_config_candidates() {
  if [[ -n "${CODESEEQ_GGUF_MODELS_JSON:-}" && -f "${CODESEEQ_GGUF_MODELS_JSON}" ]]; then
    printf '%s\n' "${CODESEEQ_GGUF_MODELS_JSON}"
  fi
  local static="${CODESEEQ_HOST_MODEL_CATALOG_JSON:-/etc/codeseeq/codex-model-catalog.json}"
  printf '%s\n' "$(dirname "$static")/gguf-models.json"
  printf '%s\n' "/etc/codeseeq/gguf-models.json"
}

# Resolve the effective GGUF context window for a model path:
# per-model config > CODESEEQ_GGUF_CONTEXT_WINDOW > 8192. Prints the number.
resolve_gguf_context_window() {
  local path="$1"
  local fallback="${CODESEEQ_GGUF_CONTEXT_WINDOW:-8192}"
  if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$fallback"
    return 0
  fi
  local candidates="" c
  while IFS= read -r c; do
    [[ -n "$c" && -f "$c" ]] || continue
    candidates="${candidates}${candidates:+,}$c"
  done < <(gguf_models_config_candidates)
  CODESEEQ_GGUF_RESOLVE_CANDIDATES="$candidates" \
  CODESEEQ_GGUF_RESOLVE_FALLBACK="$fallback" \
  python3 - "$path" <<'PYGGUF'
import json, os, sys
path = os.path.abspath(os.path.expanduser(sys.argv[1]))
cands = [c for c in os.environ.get("CODESEEQ_GGUF_RESOLVE_CANDIDATES", "").split(",") if c]
fallback = os.environ.get("CODESEEQ_GGUF_RESOLVE_FALLBACK", "8192")
value = None
for cand in cands:
    try:
        with open(cand, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        continue
    models = data.get("models") if isinstance(data, dict) else None
    if not isinstance(models, dict):
        continue
    base = os.path.basename(path)
    stem = base[:-5] if base.lower().endswith(".gguf") else base
    tilde = os.path.join("~", os.path.relpath(path, os.path.expanduser("~")))
    for key in (path, tilde, base, stem, "gguf@" + path):
        entry = models.get(key)
        if isinstance(entry, dict) and entry.get("context_window") is not None:
            value = entry["context_window"]
            break
    if value is not None:
        break
if value is None:
    value = fallback
print(value)
PYGGUF
}

write_merged_codex_catalog() {
  local output="$1"
  local static="${CODESEEQ_HOST_MODEL_CATALOG_JSON:-/etc/codeseeq/codex-model-catalog.json}"
  local model="${CODESEEQ_MODEL:-${PROVIDER_MODEL:-}}"
  if [[ -z "$model" || ! -f "$static" ]]; then
    cp "$static" "$output" 2>/dev/null || return 0
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    cp "$static" "$output" 2>/dev/null || true
    return 0
  fi
  mkdir -p "$(dirname "$output")"
  # Per-model GGUF context/max-tokens flow into the Codex catalog so the
  # client-side truncation matches the llama-server -c flag (previously the
  # merged entry was hardcoded to 131072 while the server defaulted to 8192).
  local catalog_ctx=131072 catalog_max_tokens=32768 catalog_is_gguf=0
  local model_lower gguf_model_path=""
  model_lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
  if [[ "$model" == gguf@* ]]; then
    gguf_model_path="${model#gguf@}"
  elif [[ "$model_lower" == *.gguf ]]; then
    gguf_model_path="$model"
  fi
  if [[ -n "$gguf_model_path" ]]; then
    catalog_is_gguf=1
    catalog_ctx="$(resolve_gguf_context_window "$gguf_model_path")"
    catalog_max_tokens="${CODESEEQ_GGUF_MAX_OUTPUT_TOKENS:-2048}"
  fi
  CODESEEQ_CATALOG_STATIC="$static" \
  CODESEEQ_CATALOG_OUTPUT="$output" \
  CODESEEQ_CATALOG_MODEL="$model" \
  CODESEEQ_CATALOG_CTX="$catalog_ctx" \
  CODESEEQ_CATALOG_MAX_TOKENS="$catalog_max_tokens" \
  CODESEEQ_CATALOG_IS_GGUF="$catalog_is_gguf" \
  python3 - <<'PYCAT'
import json, os

static = os.environ["CODESEEQ_CATALOG_STATIC"]
output = os.environ["CODESEEQ_CATALOG_OUTPUT"]
model = os.environ.get("CODESEEQ_CATALOG_MODEL", "")
catalog_ctx = int(os.environ.get("CODESEEQ_CATALOG_CTX", "131072"))
catalog_max_tokens = int(os.environ.get("CODESEEQ_CATALOG_MAX_TOKENS", "32768"))
catalog_is_gguf = os.environ.get("CODESEEQ_CATALOG_IS_GGUF", "") == "1"

def _main() -> None:
    try:
        with open(static, "r", encoding="utf-8") as fh:
            cat = json.load(fh)
    except Exception:
        return
    if not isinstance(cat, dict):
        cat = {"models": []}
    models = cat.get("models")
    if not isinstance(models, list):
        models = []
        cat["models"] = models
    slugs = {m.get("slug") for m in models if isinstance(m, dict)}
    if model and model not in slugs:
        thinking = model.rstrip("/").endswith("-thinking") or model.endswith("thinking")
        models.append({
            "slug": model,
            "display_name": model,
            "description": "User-configured model (via codeseeq config)",
            "base_instructions": "",
            "enable_thinking": thinking,
            "context_window": catalog_ctx,
            "max_context_window": catalog_ctx,
            "max_output_tokens": catalog_max_tokens,
            "timeout_seconds": 600,
            "supports_reasoning_summaries": thinking,
            "supported_in_api": True,
            "visibility": "list",
            "shell_type": "default",
            "web_search_tool_type": "text",
            "truncation_policy": {"mode": "tokens", "limit": catalog_ctx},
            "supports_parallel_tool_calls": True,
            "priority": 99,
            "supported_reasoning_levels": [
                {"level": "high", "effort": "high", "description": "High reasoning effort"},
                {"level": "xhigh", "effort": "high", "description": "Extra-high reasoning effort"},
            ] if thinking else [],
            "input_modalities": ["text"],
            "supports_search_tool": True,
            "support_verbosity": False,
            "experimental_supported_tools": [],
        })
    # Keep the generic gguf@local-model placeholder in sync with the resolved
    # context so Codex never truncates a GGUF session at the stale static 8192.
    if catalog_is_gguf:
        for m in models:
            if isinstance(m, dict) and m.get("slug") == "gguf@local-model":
                m["context_window"] = catalog_ctx
                m["max_context_window"] = catalog_ctx
                m["max_output_tokens"] = catalog_max_tokens
                m["truncation_policy"] = {"mode": "tokens", "limit": catalog_ctx}
    try:
        with open(output, "w", encoding="utf-8") as fh:
            json.dump(cat, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
    except Exception:
        pass

_main()
PYCAT
}

# Native ChatGPT account sign-in config (container variant): see the host
# wrapper equivalent. model_provider = "openai" is upstream Codex's built-in
# ChatGPT-auth provider (requires_openai_auth = true, no env_key, no API key).
write_config_chatgpt() {
  local upstream
  upstream="$(chatgpt_upstream_model)"
  mkdir -p "$CODESEEQ_CODEX_HOME"
  export CODEX_HOME="$CODESEEQ_CODEX_HOME"
  cat > "$CODESEEQ_CODEX_HOME/config.toml" <<EOF
# CodeSeeq chatgpt provider: native OpenAI/ChatGPT account sign-in
# (Plus/Pro/Team). model_provider = "openai" is upstream Codex's built-in
# ChatGPT-auth provider (requires_openai_auth = true, no env_key, no API key).
model = "${upstream}"
model_provider = "openai"

approval_policy = "${CODESEEQ_APPROVAL_POLICY}"
sandbox_mode = "${CODESEEQ_SANDBOX_MODE}"

web_search = "live"

[analytics]
enabled = false

[feedback]
enabled = false

[otel]
exporter = "none"
metrics_exporter = "none"
trace_exporter = "none"
log_user_prompt = false

[history]
persistence = "none"
EOF

  if system_prompt_present; then
    {
      printf '\n# CodeSeeq-managed persistent system prompt.\n'
      printf 'developer_instructions = '
      toml_quote_file "$CODESEEQ_SYSTEM_PROMPT_FILE"
      printf '\n'
    } >> "$CODESEEQ_CODEX_HOME/config.toml"
  fi
  chmod 600 "$CODESEEQ_CODEX_HOME/config.toml"
}

write_config() {
  export CODEX_HOME="$CODESEEQ_CODEX_HOME"
  write_merged_codex_catalog "${CODESEEQ_CODEX_HOME}/codex-model-catalog.json"

  local provider_env provider_label

  # ChatGPT account sign-in is native (no bridge); write a dedicated
  # config and skip the CodeSeeq bridge provider entirely.
  if is_chatgpt_model; then
    write_config_chatgpt
    return 0
  fi
  provider_env="$(provider_key_env_for_model)"
  if [[ -z "$provider_env" ]]; then
    # Keyless providers (gguf / mlx / local / qwibus): Codex still requires
    # the env_key variable to EXIST in the environment, so point it at an
    # internal sentinel that is always exported (never used as a real
    # credential; the bridge omits Authorization for keyless providers).
    provider_env="CODESEEQ_KEYLESS_TOKEN"
    export CODESEEQ_KEYLESS_TOKEN="codeseeq-keyless-local-provider"
  fi
  case "${PROVIDER_MODEL:-}" in
    anthropic@*) provider_label="CodeSeeq Anthropic Bridge" ;;
    google@*) provider_label="CodeSeeq Google Bridge" ;;
    grok@*) provider_label="CodeSeeq Grok Bridge" ;;
    venice@*) provider_label="CodeSeeq Venice Bridge" ;;
    qwibus@*|local@*) provider_label="CodeSeeq Local Bridge" ;;
    gguf@*) provider_label="CodeSeeq GGUF Bridge" ;;
    *) provider_label="CodeSeeq DeepSeek Bridge" ;;
  esac
  # GGUF models use their resolved per-model context window so the Codex
  # client window matches the llama-server -c flag; other providers keep the
  # generic CODESEEQ_CONTEXT_WINDOW (default 1000000).
  local model_context_window="${CODESEEQ_CONTEXT_WINDOW}"
  case "${PROVIDER_MODEL:-}" in
    gguf@*) model_context_window="$(resolve_gguf_context_window "${PROVIDER_MODEL#gguf@}")" ;;
  esac
  cat > "$CODESEEQ_CODEX_HOME/config.toml" <<EOF
model = "${PROVIDER_MODEL}"
model_provider = "codeseeq"
model_catalog_json = "${CODESEEQ_CODEX_HOME}/codex-model-catalog.json"

approval_policy = "${CODESEEQ_APPROVAL_POLICY}"
sandbox_mode = "${CODESEEQ_SANDBOX_MODE}"

model_context_window = ${model_context_window}
model_supports_reasoning_summaries = false
model_reasoning_summary = "none"

web_search = "live"

[analytics]
enabled = false

[feedback]
enabled = false

[otel]
exporter = "none"
metrics_exporter = "none"
trace_exporter = "none"
log_user_prompt = false

[history]
persistence = "none"
EOF

  if system_prompt_present; then
    {
      printf '\n# CodeSeeq-managed persistent system prompt.\n'
      printf 'developer_instructions = '
      toml_quote_file "$CODESEEQ_SYSTEM_PROMPT_FILE"
      printf '\n'
    } >> "$CODESEEQ_CODEX_HOME/config.toml"
  fi

  cat >> "$CODESEEQ_CODEX_HOME/config.toml" <<EOF

[model_providers.codeseeq]
name = "${provider_label}"
base_url = "${CODESEEQ_OPENRESPONSES_URL}"
env_key = "${provider_env}"
wire_api = "responses"
requires_openai_auth = false
request_max_retries = ${CODESEEQ_REQUEST_MAX_RETRIES}
stream_max_retries = 2
stream_idle_timeout_ms = ${CODESEEQ_STREAM_IDLE_TIMEOUT_MS}
supports_websockets = false
EOF

  chmod 600 "$CODESEEQ_CODEX_HOME/config.toml"
}

print_config() {
  write_config
  printf 'CODEX_HOME=%s\n' "$CODEX_HOME"
  printf 'Config path=%s\n' "$CODESEEQ_CODEX_HOME/config.toml"
  printf 'System prompt status=%s\n' "$(system_prompt_state)"
  printf 'System prompt path=%s\n' "$CODESEEQ_SYSTEM_PROMPT_FILE"
  printf 'System prompt bytes=%s\n' "$(system_prompt_bytes)"
  printf 'System prompt lines=%s\n' "$(system_prompt_lines)"
  printf 'System prompt injection=%s\n' "$CODESEEQ_SYSTEM_PROMPT_INJECTION"
  sed 's/^developer_instructions = .*/developer_instructions = "<redacted: CodeSeeq system prompt>"/' "$CODESEEQ_CODEX_HOME/config.toml"
}

provider_key_env_for_model() {
  # Map a canonical provider@model slug to the API-key environment variable.
  # Keyless providers (qwibus / local gateways) print nothing. A set
  # CODESEEQ_PROVIDER overrides slug-derived routing (mirroring the bridge),
  # so the key required here always matches the provider the bridge will use.
  local model="${1:-${PROVIDER_MODEL:-${CODESEEQ_MODEL:-}}}"
  case "${CODESEEQ_PROVIDER:-}" in
    anthropic) printf 'ANTHROPIC_API_KEY'; return 0 ;;
    google) printf 'GOOGLE_API_KEY'; return 0 ;;
    grok) printf 'GROK_API_KEY'; return 0 ;;
    venice) printf 'VENICE_API_KEY'; return 0 ;;
    deepseek) printf 'DEEPSEEK_API_KEY'; return 0 ;;
    local|qwibus|gguf|chatgpt) printf ''; return 0 ;;
  esac
  case "$model" in
    qwibus@*|local@*|gguf@*|chatgpt@*) printf '' ;;
    anthropic@*) printf 'ANTHROPIC_API_KEY' ;;
    google@*) printf 'GOOGLE_API_KEY' ;;
    grok@*) printf 'GROK_API_KEY' ;;
    venice@*) printf 'VENICE_API_KEY' ;;
    *) printf 'DEEPSEEK_API_KEY' ;;
  esac
}



require_deepseek_key() {
  # qwibus/local models run on local gateways and require no API key.
  local env_name
  env_name="$(provider_key_env_for_model)"
  if [[ -z "$env_name" ]]; then
    return 0
  fi
  [[ -n "${!env_name:-}" ]] || die "${env_name} is required. Set it in your environment or run: codeseeq config"
  # CodeSeeq privacy hardening: OPENAI_API_KEY is no longer auto-populated from provider keys
}

ping_deepseek() {
  require_deepseek_key
  PROVIDER_PING_KEY_ENV="$(provider_key_env_for_model)"
  PROVIDER_PING_KEY="${!PROVIDER_PING_KEY_ENV:-}"
  start_bridge || die "failed to start bridge"

  local payload
  payload=$(cat <<EOF
{"model":"${PROVIDER_MODEL}","stream":false,"input":"Return exactly: codeseeq-ok"}
EOF
)

  local out
  out="$(curl --silent --show-error --fail \
    -H 'Content-Type: application/json' \
    -H "Authorization: Bearer ${PROVIDER_PING_KEY:-${DEEPSEEK_API_KEY:-missing}}" \
    -d "$payload" \
    "${CODESEEQ_OPENRESPONSES_URL}/responses")"

  if grep -Eqi 'codeseeq-ok|codeseek-ok|codeeseq-ok' <<<"$out"; then
    echo "PONG: codeseeq-ok"
  else
    echo "$out" >&2
    die "ping response missing expected token"
  fi
}

ping_stream() {
  require_deepseek_key
  PROVIDER_PING_KEY_ENV="$(provider_key_env_for_model)"
  PROVIDER_PING_KEY="${!PROVIDER_PING_KEY_ENV:-}"
  start_bridge || die "failed to start bridge"

  local payload
  payload=$(cat <<EOF
{"model":"${PROVIDER_MODEL}","stream":true,"input":"Return exactly: codeseeq-stream-ok"}
EOF
)

  local out
  out="$(curl --silent --show-error --fail \
    -N \
    -H 'Content-Type: application/json' \
    -H "Authorization: Bearer ${PROVIDER_PING_KEY:-${DEEPSEEK_API_KEY:-missing}}" \
    -d "$payload" \
    "${CODESEEQ_OPENRESPONSES_URL}/responses")"

  if grep -q 'response.output_text.delta' <<<"$out" \
    && grep -q 'response.completed' <<<"$out" \
    && grep -Eqi 'codeseeq-stream-ok|codeseek-stream-ok' <<<"$out"; then
    echo "PONG-STREAM: codeseeq-stream-ok"
  else
    echo "$out" >&2
    die "streaming ping failed"
  fi
}

ping_image() {
  [[ -n "${VENICE_API_KEY:-}" ]] || die "VENICE_API_KEY is required for ping-image"
  if [[ "${CODESEEQ_IMAGE_BACKEND:-none}" != "venice" ]]; then
    die "ping-image requires CODESEEQ_IMAGE_BACKEND=venice"
  fi
  start_bridge || die "failed to start bridge"

  local payload
  payload=$(cat <<'INNEREOF'
{"model":"MODEL_PLACEHOLDER","prompt":"A red circle on white background","size":"256x256"}
INNEREOF
)
  payload="${payload/MODEL_PLACEHOLDER/${CODESEEQ_VENICE_IMAGE_MODEL:-z-image-turbo}}"

  local out attempt
  for attempt in 1 2 3; do
    if out="$(curl --silent --show-error --fail       -H 'Content-Type: application/json'       -H "Authorization: Bearer ${VENICE_API_KEY}"       -d "$payload"       "${CODESEEQ_OPENRESPONSES_URL}/images/generations" 2>&1)"; then
      break
    fi
    if (( attempt == 3 )); then
      echo "$out" >&2
      die "image generation ping failed after retries"
    fi
    sleep 1
  done

  if echo "$out" | grep -q 'b64_json'; then
    echo "PONG-IMAGE: success"
  else
    echo "$out" >&2
    die "image generation ping failed: unexpected response"
  fi
}

ping_web() {
  require_deepseek_key
  PROVIDER_PING_KEY_ENV="$(provider_key_env_for_model)"
  PROVIDER_PING_KEY="${!PROVIDER_PING_KEY_ENV:-}"
  [[ -n "${BRAVE_API_KEY:-}" ]] || die "BRAVE_API_KEY is required for ping-web"
  start_bridge || die "failed to start bridge"

  local payload
  payload=$(cat <<EOF
{"model":"${PROVIDER_MODEL}","stream":false,"codeseeq_tool":"web_search","query":"latest DeepSeek API update"}
EOF
)

  local out attempt
  for attempt in 1 2 3; do
    if out="$(curl --silent --show-error --fail \
      -H 'Content-Type: application/json' \
      -H "Authorization: Bearer ${PROVIDER_PING_KEY:-${DEEPSEEK_API_KEY:-missing}}" \
      -d "$payload" \
      "${CODESEEQ_OPENRESPONSES_URL}/responses")"; then
      break
    fi
    if (( attempt == 3 )); then
      die "web search ping failed after retries"
    fi
    sleep 1
  done

  if grep -q 'result_count' <<<"$out"; then
    echo "PONG-WEB: success"
  else
    echo "$out" >&2
    die "web search ping failed"
  fi
}

ping_docs() {
  require_deepseek_key
  PROVIDER_PING_KEY_ENV="$(provider_key_env_for_model)"
  PROVIDER_PING_KEY="${!PROVIDER_PING_KEY_ENV:-}"
  [[ -n "${UNSTRUCTURED_API_KEY:-}" ]] || die "UNSTRUCTURED_API_KEY is required for ping-docs"
  start_bridge || die "failed to start bridge"

  local payload
  payload=$(cat <<EOF
{"model":"${PROVIDER_MODEL}","stream":false,"codeseeq_tool":"doc_parse","text":"CodeSeeq parser smoke: list three nouns only."}
EOF
)

  local out attempt
  for attempt in 1 2 3; do
    if out="$(curl --silent --show-error --fail \
      -H 'Content-Type: application/json' \
      -H "Authorization: Bearer ${PROVIDER_PING_KEY:-${DEEPSEEK_API_KEY:-missing}}" \
      -d "$payload" \
      "${CODESEEQ_OPENRESPONSES_URL}/responses")"; then
      break
    fi
    if (( attempt == 3 )); then
      die "doc parsing ping failed after retries"
    fi
    sleep 1
  done

  if grep -q 'elements' <<<"$out"; then
    echo "PONG-DOCS: success"
  else
    echo "$out" >&2
    die "doc parsing ping failed"
  fi
}

doctor() {
  write_config

  local deepseek_state brave_state unstructured_state stream_state health_state deepseek_provider_state
  local provider_name provider_env provider_state
  provider_name="$(provider_key_env_for_model)"
  if is_chatgpt_model; then
    provider_label="chatgpt"
    provider_state="ChatGPT account sign-in (no API key)"
  elif [[ -z "$provider_name" ]]; then
    provider_label="local"
    provider_state="keyless"
  else
    case "${PROVIDER_MODEL:-}" in
      anthropic@*) provider_label="anthropic" ;;
      google@*) provider_label="google" ;;
      grok@*) provider_label="grok" ;;
      venice@*) provider_label="venice" ;;
      *) provider_label="deepseek" ;;
    esac
    if [[ -n "${!provider_name:-}" ]]; then
      provider_state="configured"
    else
      provider_state="not-configured"
    fi
  fi
  deepseek_state="$(key_state "${DEEPSEEK_API_KEY:-}")"
  brave_state="$(key_state "${BRAVE_API_KEY:-}")"
  unstructured_state="$(key_state "${UNSTRUCTURED_API_KEY:-}")"

  if [[ "$brave_state" == "present" ]]; then
    brave_state="enabled"
  else
    brave_state="disabled"
  fi

  if [[ "$unstructured_state" == "present" ]]; then
    unstructured_state="enabled"
  else
    unstructured_state="disabled"
  fi

  stream_state="supported"

  if start_bridge && bridge_health; then
    health_state="up"
  else
    health_state="down"
  fi

  cat <<EOF
CodeSeeq Doctor
==============
Runtime mode: ${CODESEEQ_RUNTIME_MODE:-auto}
Bridge mode: ${CODESEEQ_BRIDGE_MODE:-auto}
Model (logical): ${CODESEEQ_MODEL}
Model (provider): ${PROVIDER_MODEL}
Thinking: ${CODESEEQ_THINKING}
CODEX_HOME: ${CODEX_HOME}
Config path: ${CODESEEQ_CODEX_HOME}/config.toml
Approval policy: ${CODESEEQ_APPROVAL_POLICY}
Sandbox mode: ${CODESEEQ_SANDBOX_MODE}
Yolo mode: ${CODESEEQ_YOLO}
Workspace host: ${CODESEEQ_HOST_WORKDIR:-unknown}
Workspace container: ${CODESEEQ_WORKDIR}
System prompt: $(system_prompt_state)
System prompt path: ${CODESEEQ_SYSTEM_PROMPT_FILE}
System prompt bytes: $(system_prompt_bytes)
System prompt lines: $(system_prompt_lines)
System prompt injection: ${CODESEEQ_SYSTEM_PROMPT_INJECTION}
Image backend: ${CODESEEQ_IMAGE_BACKEND:-none}
Venice image model: ${CODESEEQ_VENICE_IMAGE_MODEL:-z-image-turbo}
Venice API key: $(key_state "${VENICE_API_KEY:-}")
Bridge URL: ${CODESEEQ_OPENRESPONSES_URL}
Bridge startup command: ${CODESEEQ_OPENRESPONSES_CMD}
Bridge health: ${health_state}
Provider: ${provider_label}
Provider API key (${provider_name:-none}): ${provider_state}
DeepSeek provider key: ${deepseek_state}
Brave web_search: ${brave_state}
Unstructured doc parsing: ${unstructured_state}
Streaming/chunked responses: ${stream_state}
Bridge implementation: bin/codeseeq-bridge.py
Runtime mode: ${CODESEEQ_RUNTIME_MODE:-auto}
Bridge mode: ${CODESEEQ_BRIDGE_MODE:-auto}
EOF
}

print_models() {
  cat /etc/codeseeq/model-catalog.json
}

run_codex_exec() {
  cd "$CODESEEQ_WORKDIR"

  local prompt_file="${CODESEEQ_RUN_PROMPT_FILE:-}"
  local inline=()
  local exec_passthrough=()
  local arg
  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      -f|--file)
        [[ $# -ge 2 ]] || die "run: $arg requires a file path"
        [[ -z "$prompt_file" || "$prompt_file" == "$2" ]] || die "run: only one prompt file may be provided"
        prompt_file="$2"
        shift 2
        ;;
      --file=*)
        local file_arg="${arg#--file=}"
        [[ -z "$prompt_file" || "$prompt_file" == "$file_arg" ]] || die "run: only one prompt file may be provided"
        prompt_file="$file_arg"
        shift
        ;;
      --model|-m)
        [[ $# -ge 2 ]] || die "run: $arg requires a value"
        CODESEEQ_MODEL="$2"
        shift 2
        ;;
      --model=*)
        CODESEEQ_MODEL="${arg#--model=}"
        shift
        ;;
      --thinking)
        CODESEEQ_THINKING="true"
        shift
        ;;
      --no-thinking)
        CODESEEQ_THINKING="false"
        shift
        ;;
      --yolo|-y|--dangerously-bypass-approvals-and-sandbox)
        CODESEEQ_YOLO="true"
        shift
        ;;
      --sandbox|--sanbox|-s)
        [[ $# -ge 2 ]] || die "run: $arg requires a value"
        CODESEEQ_SANDBOX_MODE="$2"
        shift 2
        ;;
      --sandbox=*|--sanbox=*)
        CODESEEQ_SANDBOX_MODE="${arg#*=}"
        shift
        ;;
      --ask-for-approval|-a)
        [[ $# -ge 2 ]] || die "run: $arg requires a value"
        CODESEEQ_APPROVAL_POLICY="$2"
        shift 2
        ;;
      --ask-for-approval=*)
        CODESEEQ_APPROVAL_POLICY="${arg#--ask-for-approval=}"
        shift
        ;;
      --)
        shift
        while (( $# > 0 )); do
          inline+=("$1")
          shift
        done
        ;;
      --*=*)
        exec_passthrough+=("$arg")
        shift
        ;;
      -*)
        if codex_option_takes_value "$arg"; then
          [[ $# -ge 2 ]] || die "run: $arg requires a value"
          exec_passthrough+=("$arg" "$2")
          shift 2
        else
          exec_passthrough+=("$arg")
          shift
        fi
        ;;
      *)
        inline+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "$prompt_file" && ${#inline[@]} -gt 0 ]]; then
    die "run: provide either -f/--file or inline prompt text, not both"
  fi
  if [[ -z "$prompt_file" && ${#inline[@]} -eq 0 ]]; then
    die "run requires a prompt or -f/--file"
  fi
  if [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || die "run: prompt file not found: $prompt_file"
    [[ -r "$prompt_file" ]] || die "run: prompt file is not readable: $prompt_file"
  fi

  normalize_model "$CODESEEQ_MODEL" "$CODESEEQ_THINKING"
  CODESEEQ_YOLO="$(bool_normalize "$CODESEEQ_YOLO")"
  export CODESEEQ_YOLO CODESEEQ_APPROVAL_POLICY CODESEEQ_SANDBOX_MODE
  require_deepseek_key
  write_config
  if is_chatgpt_model; then
    chatgpt_login_required_check "$CODESEEQ_CODEX_HOME"
  fi
  start_bridge || die "failed to start bridge"

  build_codex_global_args
  build_codex_exec_args
  if ((${#exec_passthrough[@]} > 0)); then
    CODEX_EXEC_ARGS+=("${exec_passthrough[@]}")
  fi
  print_workspace_banner
  if [[ -n "$prompt_file" ]]; then
    exec codex "${CODEX_GLOBAL_ARGS[@]}" exec "${CODEX_EXEC_ARGS[@]}" - < "$prompt_file"
  fi
  local prompt
  prompt="${inline[*]}"
  exec codex "${CODEX_GLOBAL_ARGS[@]}" exec "${CODEX_EXEC_ARGS[@]}" "$prompt"
}

run_codex_interactive() {
  require_deepseek_key
  write_config
  if is_chatgpt_model; then
    chatgpt_login_required_check "$CODESEEQ_CODEX_HOME"
  fi
  start_bridge || die "failed to start bridge"
  cd "$CODESEEQ_WORKDIR"
  build_codex_global_args
  print_workspace_banner
  exec codex "${CODEX_GLOBAL_ARGS[@]}" "$@"
}

build_codex_global_args() {
  if is_chatgpt_model; then
    # Native ChatGPT auth: upstream Codex needs the bare OpenAI model id
    # (gpt-5-codex, ...), not the chatgpt@ slug.
    CODEX_GLOBAL_ARGS=(--model "$(chatgpt_upstream_model)")
  else
    CODEX_GLOBAL_ARGS=(--model "$PROVIDER_MODEL")
  fi
  if [[ "$CODESEEQ_YOLO" == "true" ]]; then
    CODEX_GLOBAL_ARGS+=(--dangerously-bypass-approvals-and-sandbox)
  elif [[ "$CODESEEQ_SANDBOX_MODE" == "danger-full-access" ]]; then
    CODEX_GLOBAL_ARGS+=(--dangerously-bypass-approvals-and-sandbox)
  else
    CODEX_GLOBAL_ARGS+=(--ask-for-approval "$CODESEEQ_APPROVAL_POLICY")
    CODEX_GLOBAL_ARGS+=(--sandbox "$CODESEEQ_SANDBOX_MODE")
  fi
}

build_codex_exec_args() {
  CODEX_EXEC_ARGS=(--skip-git-repo-check)
}

codex_args_have() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$needle" ]] && return 0
  done
  return 1
}

is_codex_subcommand() {
  case "$1" in
    exec|e|review|login|logout|mcp|plugin|mcp-server|app-server|app|completion|update|sandbox|debug|apply|a|resume|fork|cloud|exec-server|features|help|version)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}
# CodeSeeq privacy hardening: block upstream Codex commands that may contact OpenAI/ChatGPT services
is_blocked_upstream_command() {
  case "$1" in
    login|logout|cloud|app|app-server|plugin|update|features|remote-control)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

block_upstream_codex_commands() {
  local cmd_arg="$1"
  shift || true
  if is_blocked_upstream_command "$cmd_arg"; then
    # The chatgpt provider is CodeSeeq's explicit opt-in for OpenAI/ChatGPT
    # account sign-in: `login` / `logout` are required for the feature and are
    # auto-allowed in that mode only (all other providers stay blocked).
    local chatgpt_auth_allowed=false
    if [[ "$cmd_arg" == "login" || "$cmd_arg" == "logout" ]] && { is_chatgpt_model || requested_chatgpt_model "$@"; }; then
      chatgpt_auth_allowed=true
    fi
    if [[ "$(bool_normalize "${CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES:-false}")" == "true" ]]; then
      warn "CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true: allowing potentially risky upstream Codex command: ${cmd_arg}"
      return 0
    fi
    if [[ "$chatgpt_auth_allowed" == "true" ]]; then
      log "chatgpt provider: allowing upstream Codex '${cmd_arg}' for ChatGPT account sign-in"
      return 0
    fi
    die "disabled in CodeSeeq privacy mode: this upstream Codex command may contact OpenAI/ChatGPT services or modify/update Codex state (set CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true to override, or use the chatgpt provider for account sign-in)"
  fi
  return 0
}

codex_option_takes_value() {
  case "$1" in
    --model|-m|--sandbox|--sanbox|-s|-p|--profile|--prompt|--cd|-C|--ask-for-approval|-a|--config|-c|--output-last-message|-o|--output-schema|--color|--image|-i|--add-dir|--enable|--disable|--remote|--remote-auth-token-env|--local-provider)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

split_direct_prompt_args() {
  DIRECT_CODEX_ARGS=()
  DIRECT_PROMPT_PARTS=()

  local arg
  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      --)
        shift
        [[ $# -gt 0 ]] || return 1
        DIRECT_PROMPT_PARTS=("$@")
        return 0
        ;;
      --*=*)
        DIRECT_CODEX_ARGS+=("$arg")
        shift
        ;;
      -*)
        if codex_option_takes_value "$arg"; then
          [[ $# -ge 2 ]] || die "$arg requires a value"
          DIRECT_CODEX_ARGS+=("$arg" "$2")
          shift 2
        else
          DIRECT_CODEX_ARGS+=("$arg")
          shift
        fi
        ;;
      *)
        if is_codex_subcommand "$arg"; then
          return 1
        fi
        DIRECT_PROMPT_PARTS=("$@")
        return 0
        ;;
    esac
  done

  return 1
}

run_codex_passthrough() {
  case "${1:-}" in
    --help|-h|help|--version|-V|version)
      exec codex "$@"
      ;;
  esac

  if is_chatgpt_model && [[ "${1:-}" == "login" || "${1:-}" == "logout" ]]; then
    warn "container CODEX_HOME (${CODESEEQ_CODEX_HOME}) is wiped on --rm runs; the host wrapper forces host runtime for chatgpt account sign-in (run: codeseeq login on the host)"
  fi

  require_deepseek_key
  write_config
  start_bridge || die "failed to start bridge"
  cd "$CODESEEQ_WORKDIR"

  build_codex_global_args

  if [[ "${1:-}" == "exec" || "${1:-}" == "e" ]]; then
    local passthrough=("$@")
    if ! codex_args_have "--skip-git-repo-check" "${passthrough[@]}"; then
      passthrough=("${passthrough[0]}" --skip-git-repo-check "${passthrough[@]:1}")
    fi
    print_workspace_banner
    exec codex "${CODEX_GLOBAL_ARGS[@]}" "${passthrough[@]}"
  fi

  print_workspace_banner
  exec codex "${CODEX_GLOBAL_ARGS[@]}" "$@"
}

open_shell() {
  write_config
  start_bridge || true
  cd "$CODESEEQ_WORKDIR"
  exec bash
}

print_help() {
  cat <<'EOF'
CodeSeeq - Codex CLI wired to multiple LLM providers through the CodeSeeq bridge

Usage:
  codeseeq [codex-options] [prompt]
  codeseeq "prompt"
  codeseeq run "prompt"
  codeseeq run -f task.md
  codeseeq codex [args...]

Commands:
  run, models, doctor, config, ping, ping-stream, ping-web, ping-docs, ping-image, shell, codex
  (login/logout: only for the chatgpt provider - native ChatGPT account sign-in,
   no API key; the host wrapper forces host runtime for chatgpt)

Safety defaults:
  approval_policy=on-request
  sandbox_mode=workspace-write

Explicit --yolo/-y maps to Codex's dangerous bypass switch.
-p and --profile are Codex profile flags, not CodeSeeq prompt flags.
EOF
}

# Parse wrapper flags before subcommand/args.
args=()
while (( $# > 0 )); do
  case "$1" in
    --model|-m)
      [[ $# -ge 2 ]] || die "--model requires a value"
      CODESEEQ_MODEL="$2"
      shift 2
      ;;
    --model=*)
      CODESEEQ_MODEL="${1#--model=}"
      shift
      ;;
    --thinking)
      CODESEEQ_THINKING="true"
      shift
      ;;
    --no-thinking)
      CODESEEQ_THINKING="false"
      shift
      ;;
    --yolo|-y)
      CODESEEQ_YOLO="true"
      shift
      ;;
    --dangerously-bypass-approvals-and-sandbox)
      CODESEEQ_YOLO="true"
      shift
      ;;
    --sandbox|--sanbox|-s)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      CODESEEQ_SANDBOX_MODE="$2"
      shift 2
      ;;
    --sandbox=*|--sanbox=*)
      CODESEEQ_SANDBOX_MODE="${1#*=}"
      shift
      ;;
    --ask-for-approval|-a)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      CODESEEQ_APPROVAL_POLICY="$2"
      shift 2
      ;;
    --ask-for-approval=*)
      CODESEEQ_APPROVAL_POLICY="${1#--ask-for-approval=}"
      shift
      ;;
    --)
      shift
      while (( $# > 0 )); do
        args+=("$1")
        shift
      done
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
  if (( $# == 0 )); then
    break
  fi

done

if ((${#args[@]} > 0)); then
  set -- "${args[@]}"
else
  set --
fi

CODESEEQ_YOLO="$(bool_normalize "$CODESEEQ_YOLO")"
if [[ "$CODESEEQ_YOLO" != "true" && "$CODESEEQ_YOLO" != "false" ]]; then
  die "invalid yolo value: ${CODESEEQ_YOLO}"
fi
export CODESEEQ_YOLO CODESEEQ_APPROVAL_POLICY CODESEEQ_SANDBOX_MODE

normalize_model "$CODESEEQ_MODEL" "$CODESEEQ_THINKING"
export CODEX_HOME="$CODESEEQ_CODEX_HOME"

# CodeSeeq privacy hardening: block upstream Codex commands by default
block_upstream_codex_commands "${1:-}" "$@"

case "${1:-}" in
  "")
    run_codex_interactive
    ;;
  run)
    shift
    run_codex_exec "$@"
    ;;
  ping)
    shift
    ping_deepseek
    ;;
  ping-stream)
    shift
    ping_stream
    ;;
  ping-web)
    shift
    ping_web
    ;;
  ping-image)
    shift
    ping_image
    ;;
  ping-docs)
    shift
    ping_docs
    ;;
  doctor)
    shift
    doctor
    ;;
  models)
    shift
    print_models
    ;;
  config)
    shift
    print_config
    ;;
  shell)
    shift
    open_shell
    ;;
  codex)
    shift
    run_codex_passthrough "$@"
    ;;
  --help|-h|help)
    shift || true
    print_help
    ;;
  --version|-V|version)
    shift || true
    run_codex_passthrough --version
    ;;
  *)
    if split_direct_prompt_args "$@"; then
      if ((${#DIRECT_CODEX_ARGS[@]} > 0)); then
        run_codex_exec "${DIRECT_CODEX_ARGS[@]}" -- "${DIRECT_PROMPT_PARTS[@]}"
      else
        run_codex_exec -- "${DIRECT_PROMPT_PARTS[@]}"
      fi
    else
      run_codex_passthrough "$@"
    fi
    ;;
esac
