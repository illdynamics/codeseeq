# Auto-detect: if VENICE_API_KEY is set and backend is still "none", switch to venice
if [[ "${CODESEEQ_IMAGE_BACKEND}" == "none" && -n "${VENICE_API_KEY:-}" ]]; then
  CODESEEQ_IMAGE_BACKEND=venice
  log "auto-detected VENICE_API_KEY; image backend set to venice"
fi

BRIDGE_OWNED=""
BRIDGE_PID=""

# --- Runtime mode ---
: "${CODESEEQ_RUNTIME_MODE:=auto}"

PROVIDER_MODEL=""
THINKING_EFFECTIVE=""
TMP_FILES=()
BRIDGE_CONTAINER_STARTED=""

cleanup_tmp_files() {
  local f
  for f in "${TMP_FILES[@]:-}"; do
    [[ -n "$f" ]] && rm -f -- "$f" 2>/dev/null || true
  done
  bridge_stop_owned_process
  if [[ -n "${BRIDGE_CONTAINER_STARTED:-}" ]] && ! is_truthy "${CODESEEQ_KEEP_BRIDGE_CONTAINER:-false}"; then
    "$CONTAINER" stop "$BRIDGE_CONTAINER_STARTED" >/dev/null 2>&1 || true
  fi
}
trap cleanup_tmp_files EXIT

host_cleanup() {
  cleanup_tmp_files
}

_run_host_cleanup() {
  local s="${1:-$?}"
  host_cleanup
  return "$s"
}

print_help() {
  cat <<'EOF'
CodeSeeq - Codex CLI wired to multiple LLM providers through the CodeSeeq bridge

Usage:
  codeseeq [codex-options] [prompt]
  codeseeq "prompt"
  codeseeq run "prompt"
  codeseeq run -f task.md
  codeseeq codex [args...]

CodeSeeq commands:
  build                 Build the CodeSeeq image
  install               Install the user-local launcher
  nuke                  Remove all installed CodeSeeq artifacts
  models                Print the supported model catalog
  doctor                Check bridge/config/runtime status
  config                Interactive LLM setup (provider, model, API key)
  config status         Show the current LLM configuration
  ping                  Run a non-streaming bridge ping
  ping-stream           Run a streaming bridge ping
  ping-web              Check web_search diagnostic path
  ping-docs             Check document parsing diagnostic path
  shell                 Open a shell in the CodeSeeq container
  smoke                 Run smoke tests
  system                Manage user-config persistent system prompt
  package               Create a clean release zip

Configure the LLM:
  codeseeq config       TUI: pick provider (anthropic, google, grok,
                        deepseek, venice, local), then model, then API key.
  The wizard writes CODESEEQ_MODEL / CODESEEQ_PROVIDER and the provider API
  key to ~/.config/codeseeq/config.json (CODESEEQ_CONFIG_HOME/config.json).
  Environment variables always override config-file values.

Prompt files:
  codeseeq run -f task.md
  codeseeq run --file task.md
  codeseeq run --file=task.md

System prompt:
  codeseeq system add "You are terse and practical."
  codeseeq system add -f prompts/system.md
  codeseeq system view
  codeseeq system remove

Runtime modes:
  --runtime-mode MODE   host, container, or auto (default: auto)
  CODESEEQ_RUNTIME_MODE Set runtime mode via environment

Bridge modes:
  --bridge-mode MODE    process, container, external, or auto (default: auto)
  --bridge-url URL      Full bridge base URL (e.g. http://127.0.0.1:8080/v1)
  --bridge-port PORT    Fixed bridge port (omit for auto-select)
  CODESEEQ_BRIDGE_MODE  Set bridge mode via environment
  CODESEEQ_BRIDGE_BASE_URL  Set bridge URL via environment

Uncensored mode:
  -U, --uncensored-mode  Load Dolfino aka Dirty D uncensored system prompt
  CODESEEQ_UNCENSORED_MODE Set uncensored mode via environment

Image backend:
  --image-backend BACKEND       Set image backend: none (default) or venice
  --venice-image-model MODEL    Venice image model (default: auto,
                                e.g. z-image-turbo, gpt-image-2)
  CODESEEQ_IMAGE_BACKEND        Set image backend via environment
  VENICE_API_KEY                Required when backend=venice

Runtime:
  Podman is preferred. Docker is used as a compatible fallback when Podman is
  unavailable, or explicitly with CONTAINER=docker. Docker Compose is not used.

Safety:
  Default mode runs Codex safely inside the CodeSeeq container. Explicit
  -y, --yolo, --dangerously-bypass-approvals-and-sandbox, or
  --sandbox danger-full-access runs local host Codex with the bypass flag.
  Host runtime mode runs Codex without container isolation but still applies
  the normal Codex approval and sandbox settings unless danger/yolo is requested.

Codex compatibility:
  -p and --profile are Codex profile flags. They are passed through unchanged
  and are not CodeSeeq prompt flags.
EOF
}

print_system_help() {
  cat <<EOF
Usage:
  codeseeq system add "system prompt text"
  codeseeq system add -f path/to/system-prompt.md
  codeseeq system add --file path/to/system-prompt.md
  codeseeq system view
  codeseeq system show
  codeseeq system cat
  codeseeq system remove
  codeseeq system rm
  codeseeq system clear
  codeseeq system --help

The prompt is stored at:
  ${SYSTEM_PROMPT_PATH}
EOF
}

detect_container() {
  if [[ -n "${CONTAINER:-}" ]]; then
    case "$CONTAINER" in
      podman|docker) ;;
      *) die "unsupported container runtime: ${CONTAINER}. Use CONTAINER=podman or CONTAINER=docker." ;;
    esac
    command -v "$CONTAINER" >/dev/null 2>&1 || die "container runtime not found: ${CONTAINER}"
    printf '%s\n' "$CONTAINER"
    return 0
  fi

  if command -v podman >/dev/null 2>&1; then
    printf '%s\n' podman
    return 0
  fi

  if command -v docker >/dev/null 2>&1; then
    warn "podman not found; using docker as compatible fallback"
    printf '%s\n' docker
    return 0
  fi

  die "no container runtime found. Install Podman (preferred) or Docker, or set CONTAINER=podman|docker."
}

ensure_container_runtime() {
  if [[ -n "${CONTAINER:-}" ]]; then
    return 0
  fi
  CONTAINER="$(detect_container)"
}

volume_suffix_for_runtime() {
  if [[ -n "${CODESEEQ_VOLUME_SUFFIX+x}" ]]; then
    printf '%s' "$CODESEEQ_VOLUME_SUFFIX"
    return 0
  fi
  if [[ "$CONTAINER" == "podman" ]]; then
    printf ':Z'
  fi
}

readonly_volume_suffix_for_runtime() {
  if [[ -n "${CODESEEQ_CONFIG_VOLUME_SUFFIX+x}" ]]; then
    printf '%s' "$CODESEEQ_CONFIG_VOLUME_SUFFIX"
    return 0
  fi
  if [[ "$CONTAINER" == "podman" ]]; then
    printf ':ro,Z'
  else
    printf ':ro'
  fi
}

image_exists() {
  if [[ "$CONTAINER" == "podman" ]]; then
    "$CONTAINER" image exists "$IMAGE" >/dev/null 2>&1
  else
    "$CONTAINER" image inspect "$IMAGE" >/dev/null 2>&1
  fi
}

ensure_image() {
  if image_exists; then
    return 0
  fi
  if is_truthy "$AUTO_BUILD"; then
    log "image ${IMAGE} not found; building from ${BUILD_CONTEXT} with ${CONTAINER}"
    "$CONTAINER" build -t "$IMAGE" "$BUILD_CONTEXT"
  else
    die "image ${IMAGE} missing; run: ${CONTAINER} build -t ${IMAGE} ${BUILD_CONTEXT}"
  fi
}

toml_quote_file() {
  local path="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -Rs . < "$path"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' < "$path"
  else
    die "jq or python3 is required to quote system prompt text for Codex config"
  fi
}

system_prompt_present() {
  [[ -f "$SYSTEM_PROMPT_PATH" && -s "$SYSTEM_PROMPT_PATH" ]]
}

system_prompt_bytes() {
  if [[ -f "$SYSTEM_PROMPT_PATH" ]]; then
    wc -c < "$SYSTEM_PROMPT_PATH" | tr -d '[:space:]'
  else
    printf '0'
  fi
}

system_prompt_lines() {
  if [[ -f "$SYSTEM_PROMPT_PATH" ]]; then
    awk 'END { print NR }' "$SYSTEM_PROMPT_PATH"
  else
    printf '0'
  fi
}

system_add() {
  local file=""
  local inline=()
  while (( $# > 0 )); do
    case "$1" in
      -f|--file)
        [[ $# -ge 2 ]] || die "system add: $1 requires a file path"
        [[ -z "$file" ]] || die "system add: only one --file value is allowed"
        file="$2"
        shift 2
        ;;
      --file=*)
        [[ -z "$file" ]] || die "system add: only one --file value is allowed"
        file="${1#--file=}"
        shift
        ;;
      --help|-h)
        print_system_help
        return 0
        ;;
      *)
        inline+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "$file" && ${#inline[@]} -gt 0 ]]; then
    die "system add: provide inline text or -f/--file, not both"
  fi
  if [[ -z "$file" && ${#inline[@]} -eq 0 ]]; then
    print_system_help >&2
    die "system add: missing inline text or -f/--file"
  fi

  mkdir -p "$(dirname "$SYSTEM_PROMPT_PATH")"
  if [[ -n "$file" ]]; then
    [[ -f "$file" ]] || die "system add: file not found: $file"
    [[ -r "$file" ]] || die "system add: file is not readable: $file"
    cp -- "$file" "$SYSTEM_PROMPT_PATH"
  else
    printf '%s' "${inline[*]}" > "$SYSTEM_PROMPT_PATH"
  fi
  chmod 600 "$SYSTEM_PROMPT_PATH" 2>/dev/null || true
  printf 'Stored CodeSeeq system prompt at %s\n' "$SYSTEM_PROMPT_PATH"
}

system_view() {
  if [[ ! -f "$SYSTEM_PROMPT_PATH" ]]; then
    printf 'No CodeSeeq system prompt configured.\n'
    printf 'Path: %s\n' "$SYSTEM_PROMPT_PATH"
    return 0
  fi
  printf 'CodeSeeq system prompt\n'
  printf 'Path: %s\n' "$SYSTEM_PROMPT_PATH"
  printf 'Bytes: %s\n' "$(system_prompt_bytes)"
  printf 'Lines: %s\n' "$(system_prompt_lines)"
  printf '%s\n' '---'
  cat "$SYSTEM_PROMPT_PATH"
  printf '\n'
}

system_remove() {
  local removed="false"
  if [[ -f "$SYSTEM_PROMPT_PATH" ]]; then
    rm -f -- "$SYSTEM_PROMPT_PATH"
    printf 'Removed CodeSeeq system prompt at %s\n' "$SYSTEM_PROMPT_PATH"
    removed="true"
  fi
  if [[ "$LEGACY_SYSTEM_PROMPT_PATH" != "$SYSTEM_PROMPT_PATH" && -f "$LEGACY_SYSTEM_PROMPT_PATH" ]]; then
    rm -f -- "$LEGACY_SYSTEM_PROMPT_PATH"
    printf 'Removed legacy CodeSeeq system prompt at %s\n' "$LEGACY_SYSTEM_PROMPT_PATH"
    removed="true"
  fi
  if [[ "$removed" != "true" ]]; then
    printf 'No CodeSeeq system prompt configured; nothing to remove.\n'
    printf 'Path: %s\n' "$SYSTEM_PROMPT_PATH"
  fi
  if [[ -f "$HOST_CODEX_HOME/config.toml" ]]; then
    local tmp
    tmp="$(mktemp "${HOST_CODEX_HOME}/config.XXXXXX")"
    awk '
      /^# CodeSeeq-managed persistent system prompt\.$/ { next }
      /^developer_instructions = / { next }
      { print }
    ' "$HOST_CODEX_HOME/config.toml" > "$tmp"
    mv "$tmp" "$HOST_CODEX_HOME/config.toml"
    chmod 600 "$HOST_CODEX_HOME/config.toml" 2>/dev/null || true
  fi
}

system_cmd() {
  local sub="${1:-}"
  [[ -z "$sub" ]] || shift
  case "$sub" in
    add) system_add "$@" ;;
    view|show|cat) system_view ;;
    remove|rm|clear) system_remove ;;
    --help|-h|"") print_system_help ;;
    *) die "unknown system subcommand: $sub" ;;
  esac
}

normalize_model() {
  local model="$1"
  local thinking_override="${2:-}"
  local alias_thinking="false"

  if [[ "$model" == deepseek/deepseek-v4-* ]]; then
    model="${model/deepseek\//deepseek@}"
  fi
  if [[ "$model" == qwibus/qwibus-* ]]; then
    model="${model/qwibus\//qwibus@}"
  fi

  case "$model" in
    deepseek-v4-flash)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="false"
      ;;
    deepseek-v4-flash-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="true"
      ;;
    deepseek-v4-pro)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="false"
      ;;
    deepseek-v4-pro-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="true"
      ;;
    deepseek@deepseek-v4-flash)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="false"
      ;;
    deepseek@deepseek-v4-flash-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-flash"
      alias_thinking="true"
      ;;
    deepseek@deepseek-v4-pro)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="false"
      ;;
    deepseek@deepseek-v4-pro-thinking)
      PROVIDER_MODEL="deepseek@deepseek-v4-pro"
      alias_thinking="true"
      ;;
    qwibus-qwikk)
      PROVIDER_MODEL="qwibus@qwibus-qwikk"
      alias_thinking="false"
      ;;
    qwibus-qmplx)
      PROVIDER_MODEL="qwibus@qwibus-qmplx"
      alias_thinking="true"
      ;;
    qwibus@qwibus-qwikk)
      PROVIDER_MODEL="qwibus@qwibus-qwikk"
      alias_thinking="false"
      ;;
    qwibus@qwibus-qmplx)
      PROVIDER_MODEL="qwibus@qwibus-qmplx"
      alias_thinking="true"
      ;;
    *)
      # New provider slugs: <provider>@<model> with provider in
      # anthropic|google|grok|venice|local (deepseek/qwibus handled above).
      # A trailing "-thinking" suffix enables thinking; local accepts any
      # manually-typed model name.
      local owner upstream
      if [[ "$model" == *@* ]]; then
        owner="${model%%@*}"
        upstream="${model#*@}"
        case "$owner" in
          anthropic|google|grok|venice|deepseek|local)
            [[ -n "$upstream" ]] || die "unsupported model: ${model} (empty model name after @)"
            PROVIDER_MODEL="$model"
            alias_thinking="false"
            case "$upstream" in
              *-thinking|thinking) alias_thinking="true" ;;
            esac
            ;;
          *)
            die "unsupported provider: ${owner} in model ${model}. supported providers: deepseek, qwibus, anthropic, google, grok, venice, local"
            ;;
        esac
      else
        die "unsupported model: ${model}. supported choices: deepseek-v4-flash, deepseek-v4-flash-thinking, deepseek-v4-pro, deepseek-v4-pro-thinking, deepseek@deepseek-v4-flash, deepseek@deepseek-v4-pro, qwibus-qwikk, qwibus-qmplx, qwibus@qwibus-qwikk, qwibus@qwibus-qmplx, or <provider>@<model> with provider in anthropic, google, grok, venice, local"
      fi
      ;;
  esac

  if [[ -n "$thinking_override" ]]; then
    THINKING_EFFECTIVE="$(bool_normalize "$thinking_override")"
  else
    THINKING_EFFECTIVE="$alias_thinking"
  fi
  [[ "$THINKING_EFFECTIVE" == "true" || "$THINKING_EFFECTIVE" == "false" ]] || die "invalid thinking value: ${THINKING_EFFECTIVE}"
  CODESEEQ_MODEL="$model"
  CODESEEQ_THINKING="$THINKING_EFFECTIVE"
  if [[ "$THINKING_EFFECTIVE" == "true" ]]; then
    MODEL_SUPPORTS_REASONING_SUMMARIES="true"
    MODEL_REASONING_SUMMARY="auto"
  else
    MODEL_SUPPORTS_REASONING_SUMMARIES="false"
    MODEL_REASONING_SUMMARY="none"
  fi
  export MODEL_SUPPORTS_REASONING_SUMMARIES MODEL_REASONING_SUMMARY
}

arg_requests_danger() {
  if is_truthy "${CODESEEQ_YOLO:-false}"; then
    return 0
  fi
  if [[ "${CODESEEQ_SANDBOX_MODE:-}" == "danger-full-access" ]]; then
    return 0
  fi

  local arg next
  while (( $# > 0 )); do
    arg="$1"
    next="${2:-}"
    case "$arg" in
      -y|--yolo|--dangerously-bypass-approvals-and-sandbox)
        return 0
        ;;
      --sandbox|--sanbox|-s)
        if [[ "$next" == "danger-full-access" ]]; then
          return 0
        fi
        shift 2 || true
        continue
        ;;
      --sandbox=danger-full-access|--sanbox=danger-full-access)
        return 0
        ;;
    esac
    shift
  done
  return 1
}

first_command_arg() {
  local arg
  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      --model|-m|--sandbox|--sanbox|-s|--prompt|-p|--cd|-C|--ask-for-approval|-a|--config|-c|--profile|--output-last-message|-o|--output-schema|--color|--image|-i|--add-dir|--enable|--disable)
        shift 2 || true
        ;;
      --model=*|--sandbox=*|--sanbox=*|--prompt=*|--cd=*|--ask-for-approval=*|--config=*|--profile=*|--output-last-message=*|--output-schema=*|--color=*|--image=*|--add-dir=*|--enable=*|--disable=*)
        shift
        ;;
      --thinking|--no-thinking|-y|--yolo|--dangerously-bypass-approvals-and-sandbox|--search|--no-alt-screen|--help|-h|--version|-V)
        printf '%s\n' "$arg"
        return 0
        ;;
      --)
        shift
        [[ $# -gt 0 ]] && printf '%s\n' "$1"
        return 0
        ;;
      -*)
        shift
        ;;
      *)
        printf '%s\n' "$arg"
        return 0
        ;;
    esac
  done
}

is_codeseeq_diagnostic_command() {
  case "$1" in
    models|doctor|config|ping|ping-stream|ping-web|ping-docs|ping-image|shell) return 0 ;;
    *) return 1 ;;
  esac
}

is_codex_subcommand() {
  case "$1" in
    exec|e|review|login|logout|mcp|plugin|mcp-server|app-server|app|completion|update|sandbox|debug|apply|a|resume|fork|cloud|exec-server|features|help|version)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# CodeSeeq privacy hardening: block upstream Codex commands that may contact OpenAI/ChatGPT services
is_blocked_upstream_command() {
  case "$1" in
    login|logout|cloud|app|app-server|plugin|update|features|remote-control)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

block_upstream_codex_commands() {
  local cmd_arg="$1"
  if is_blocked_upstream_command "$cmd_arg"; then
    if is_truthy "${CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES:-false}"; then
      warn "CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true: allowing potentially risky upstream Codex command: ${cmd_arg}"
      return 0
    fi
    die "disabled in CodeSeeq privacy mode: this upstream Codex command may contact OpenAI/ChatGPT services or modify/update Codex state (set CODESEEQ_ALLOW_UPSTREAM_CODEX_SERVICES=true to override)"
  fi
  return 0
}

codex_option_takes_value() {
  case "$1" in
    --model|-m|--sandbox|--sanbox|-s|-p|--profile|--prompt|--cd|-C|--ask-for-approval|-a|--config|-c|--output-last-message|-o|--output-schema|--color|--image|-i|--add-dir|--enable|--disable|--remote|--remote-auth-token-env|--local-provider)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

split_direct_prompt_args() {
  DIRECT_CODEX_ARGS=()
  DIRECT_PROMPT_PARTS=()

  local arg
  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      --)
        shift
        [[ $# -gt 0 ]] || return 1
        DIRECT_PROMPT_PARTS=("$@")
        return 0
        ;;
      --*=*)
        DIRECT_CODEX_ARGS+=("$arg")
        shift
        ;;
      -*)
        if codex_option_takes_value "$arg"; then
          [[ $# -ge 2 ]] || die "$arg requires a value"
          DIRECT_CODEX_ARGS+=("$arg" "$2")
          shift 2
        else
          DIRECT_CODEX_ARGS+=("$arg")
          shift
        fi
        ;;
      *)
        if is_codex_subcommand "$arg"; then
          return 1
        fi
        DIRECT_PROMPT_PARTS=("$@")
        return 0
        ;;
    esac
  done

  return 1
}

provider_key_env_for_model() {
  # Map a canonical provider@model slug to the API-key environment variable.
  # Keyless providers (qwibus / local gateways) print nothing. A set
  # CODESEEQ_PROVIDER overrides slug-derived routing (mirroring the bridge),
  # so the key required here always matches the provider the bridge will use.
  local model="${1:-${PROVIDER_MODEL:-${CODESEEQ_MODEL:-}}}"
  case "${CODESEEQ_PROVIDER:-}" in
    anthropic) printf 'ANTHROPIC_API_KEY'; return 0 ;;
    google) printf 'GOOGLE_API_KEY'; return 0 ;;
    grok) printf 'GROK_API_KEY'; return 0 ;;
    venice) printf 'VENICE_API_KEY'; return 0 ;;
    deepseek) printf 'DEEPSEEK_API_KEY'; return 0 ;;
    local|qwibus) printf ''; return 0 ;;
  esac
  case "$model" in
    qwibus@*|local@*) printf '' ;;
    anthropic@*) printf 'ANTHROPIC_API_KEY' ;;
    google@*) printf 'GOOGLE_API_KEY' ;;
    grok@*) printf 'GROK_API_KEY' ;;
    venice@*) printf 'VENICE_API_KEY' ;;
    *) printf 'DEEPSEEK_API_KEY' ;;
  esac
}

require_deepseek_key() {
  # qwibus/local models run on local gateways and require no API key.
  local env_name
  env_name="$(provider_key_env_for_model)"
  if [[ -z "$env_name" ]]; then
    return 0
  fi
  [[ -n "${!env_name:-}" ]] || die "${env_name} is required. Set it in your environment or run: codeseeq config"
  # CodeSeeq privacy hardening: OPENAI_API_KEY is no longer auto-populated from provider keys
}

# Merge the static Codex model catalog with the currently configured model so
# Codex accepts any model selected via `codeseeq config` (including arbitrary
# local@<model> names). Writes to <output>; points at the static catalog when
# no merge is needed.
write_merged_codex_catalog() {
  local output="$1"
  local static="${CODESEEQ_HOST_MODEL_CATALOG_JSON:-${CODESEEQ_INSTALL_ROOT}/config/codex-model-catalog.json}"
  local model="${CODESEEQ_MODEL:-${PROVIDER_MODEL:-}}"
  if [[ -z "$model" || ! -f "$static" ]]; then
    cp "$static" "$output" 2>/dev/null || return 0
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    cp "$static" "$output" 2>/dev/null || true
    return 0
  fi
  mkdir -p "$(dirname "$output")"
  CODESEEQ_CATALOG_STATIC="$static" \
  CODESEEQ_CATALOG_OUTPUT="$output" \
  CODESEEQ_CATALOG_MODEL="$model" \
  python3 - <<'PYCAT'
import json, os

static = os.environ["CODESEEQ_CATALOG_STATIC"]
output = os.environ["CODESEEQ_CATALOG_OUTPUT"]
model = os.environ.get("CODESEEQ_CATALOG_MODEL", "")

def _main() -> None:
    try:
        with open(static, "r", encoding="utf-8") as fh:
            cat = json.load(fh)
    except Exception:
        return
    if not isinstance(cat, dict):
        cat = {"models": []}
    models = cat.get("models")
    if not isinstance(models, list):
        models = []
        cat["models"] = models
    slugs = {m.get("slug") for m in models if isinstance(m, dict)}
    if model and model not in slugs:
        thinking = model.rstrip("/").endswith("-thinking") or model.endswith("thinking")
        models.append({
            "slug": model,
            "display_name": model,
            "description": "User-configured model (via codeseeq config)",
            "base_instructions": "",
            "enable_thinking": thinking,
            "context_window": 131072,
            "max_context_window": 131072,
            "max_output_tokens": 32768,
            "timeout_seconds": 600,
            "supports_reasoning_summaries": thinking,
            "supported_in_api": True,
            "visibility": "list",
            "shell_type": "default",
            "web_search_tool_type": "text",
            "truncation_policy": {"mode": "tokens", "limit": 131072},
            "supports_parallel_tool_calls": True,
            "priority": 99,
            "supported_reasoning_levels": [
                {"level": "high", "effort": "high", "description": "High reasoning effort"},
                {"level": "max", "effort": "high", "description": "Maximum reasoning effort"},
            ] if thinking else [],
            "input_modalities": ["text"],
            "supports_search_tool": True,
            "support_verbosity": False,
            "experimental_supported_tools": [],
        })
    try:
        with open(output, "w", encoding="utf-8") as fh:
            json.dump(cat, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
    except Exception:
        pass

_main()
PYCAT
}

write_host_config() {
  mkdir -p "$HOST_CODEX_HOME"
  export CODEX_HOME="$HOST_CODEX_HOME"
  write_merged_codex_catalog "${HOST_CODEX_HOME}/codex-model-catalog.json"
  local provider_env provider_label
  provider_env="$(provider_key_env_for_model)"
  provider_env="${provider_env:-DEEPSEEK_API_KEY}"
  case "${PROVIDER_MODEL:-}" in
    anthropic@*) provider_label="CodeSeeq Anthropic Bridge" ;;
    google@*) provider_label="CodeSeeq Google Bridge" ;;
    grok@*) provider_label="CodeSeeq Grok Bridge" ;;
    venice@*) provider_label="CodeSeeq Venice Bridge" ;;
    qwibus@*|local@*) provider_label="CodeSeeq Local Bridge" ;;
    *) provider_label="CodeSeeq DeepSeek Bridge" ;;
  esac
  cat > "$HOST_CODEX_HOME/config.toml" <<EOF
model = "${PROVIDER_MODEL}"
model_provider = "codeseeq"
model_catalog_json = "${HOST_CODEX_HOME}/codex-model-catalog.json"

approval_policy = "${CODESEEQ_APPROVAL_POLICY}"
sandbox_mode = "${CODESEEQ_SANDBOX_MODE}"

model_context_window = ${CODESEEQ_CONTEXT_WINDOW}
model_supports_reasoning_summaries = false
model_reasoning_summary = "none"

web_search = "live"

[analytics]
enabled = false

[feedback]
enabled = false

[otel]
exporter = "none"
metrics_exporter = "none"
trace_exporter = "none"
log_user_prompt = false

[history]
persistence = "none"
EOF

  if system_prompt_present; then
    {
      printf '\n# CodeSeeq-managed persistent system prompt.\n'
      printf 'developer_instructions = '
      toml_quote_file "$SYSTEM_PROMPT_PATH"
      printf '\n'
    } >> "$HOST_CODEX_HOME/config.toml"
  fi
  cat >> "$HOST_CODEX_HOME/config.toml" <<EOF

