}

container_exists_by_name() {
  local name="$1"
  "$CONTAINER" ps -a --format '{{.Names}}' 2>/dev/null | grep -Fxq "$name"
}

bridge_health_host() {
  curl --silent --show-error --fail --max-time 2 --connect-timeout 1 \
    "${CODESEEQ_OPENRESPONSES_URL%/v1}/health" >/dev/null 2>&1
}

host_port_listening() {
  local port="$1"
  if [[ -n "${CODESEEQ_TEST_BUSY_PORTS+x}" ]]; then
    case " ${CODESEEQ_TEST_BUSY_PORTS:-} " in
      *" ${port} "*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  (exec 3<>"/dev/tcp/127.0.0.1/${port}") >/dev/null 2>&1
}

set_bridge_port() {
  CODESEEQ_OPENRESPONSES_PORT="$1"
  local host="${2:-127.0.0.1}"
  CODESEEQ_OPENRESPONSES_URL="http://${host}:${CODESEEQ_OPENRESPONSES_PORT}/v1"
  export CODESEEQ_OPENRESPONSES_PORT CODESEEQ_OPENRESPONSES_URL
}

set_bridge_endpoint() {
  local host="${1:-${CODESEEQ_BRIDGE_HOST:-127.0.0.1}}"
  local port="$2"
  CODESEEQ_OPENRESPONSES_PORT="$port"
  CODESEEQ_OPENRESPONSES_URL="http://${host}:${port}/v1"
  export CODESEEQ_OPENRESPONSES_PORT CODESEEQ_OPENRESPONSES_URL
}

select_host_bridge_port() {
  local start="$CODESEEQ_OPENRESPONSES_PORT"
  local limit="$CODESEEQ_OPENRESPONSES_PORT_SCAN_LIMIT"
  [[ "$start" =~ ^[0-9]+$ ]] || die "invalid CODESEEQ_OPENRESPONSES_PORT: ${start}"
  [[ "$limit" =~ ^[0-9]+$ && "$limit" -gt 0 ]] || die "invalid CODESEEQ_OPENRESPONSES_PORT_SCAN_LIMIT: ${limit}"

  local port end
  end=$((start + limit))
  for ((port = start; port < end; port++)); do
    if host_port_listening "$port"; then
      continue
    fi
    set_bridge_port "$port"
    return 0
  done

  die "no free host bridge port found in range ${start}-$((end - 1))"
}

# Names of every provider/model configuration variable the bridge reads.
# Used to forward host env (and, implicitly, JSON config values) into both the
# standalone bridge container and the Codex container. Per-model keys use the
# documented CODESEEQ_<MODEL>_<SUFFIX> scheme (provider prefix stripped).
codeseeq_bridge_env_names() {
  printf '%s\n'     DEEPSEEK_API_KEY ANTHROPIC_API_KEY GOOGLE_API_KEY GROK_API_KEY     BRAVE_API_KEY UNSTRUCTURED_API_KEY RESPONSES_API_KEY VENICE_API_KEY     LOCAL_API_KEY DEEPSEEK_CHAT_URL OPENAI_BASE_URL DEEPSEEK_BASE_URL CODESEEQ_BASE_URL     ANTHROPIC_BASE_URL GOOGLE_BASE_URL GROK_BASE_URL VENICE_BASE_URL LOCAL_BASE_URL     CODESEEQ_PROVIDER CODESEEQ_BRAVE_WEB_URL UNSTRUCTURED_API_URL     CODESEEQ_MODEL_CATALOG_JSON CODESEEQ_BRIDGE_TIMEOUT_SECONDS     CODESEEQ_BRIDGE_STREAM_CHUNK_SIZE CODESEEQ_BRIDGE_TOOL_STEERING     CODESEEQ_STREAM_IDLE_TIMEOUT_MS QWIBUS_NO_API_KEY

  local key suffix
  # Per-model keys use the CODESEEQ_<MODEL>_<SUFFIX> scheme: the bridge's
  # _model_env_key strips the "provider@" slug prefix (e.g.
  # "anthropic@claude-sonnet-4" -> CODESEEQ_CLAUDE_SONNET_4_BASE_URL), so the
  # forwarded names below must NOT repeat the provider prefix.
  for key in DEEPSEEK_V4_FLASH DEEPSEEK_V4_FLASH_THINKING DEEPSEEK_V4_PRO \
             DEEPSEEK_V4_PRO_THINKING QWIBUS_QWIKK QWIBUS_QMPLX \
             CLAUDE_SONNET_4 CLAUDE_SONNET_4_THINKING \
             CLAUDE_OPUS_4 CLAUDE_OPUS_4_THINKING CLAUDE_HAIKU_4 \
             GEMINI_2_5_PRO GEMINI_2_5_FLASH GEMINI_2_0_FLASH GEMINI_1_5_PRO \
             GROK_4 GROK_4_THINKING GROK_3 GROK_3_THINKING \
             GROK_3_MINI GROK_3_MINI_THINKING GROK_3_FAST GROK_3_FAST_THINKING \
             VENICE_QWEN_3_32B VENICE_QWEN_3_32B_THINKING VENICE_QWEN_3_14B \
             VENICE_DEEPSEEK_R1_0528 VENICE_LLAMA_3_3_70B \
             VENICE_QWEN_2_5_CODER_32B LOCAL; do
    for suffix in BASE_URL CHAT_URL TEMPERATURE TOP_P TOP_K MAX_OUTPUT_TOKENS \
                  TIMEOUT_SECONDS ENABLE_THINKING SYSTEM_PROMPT; do
      printf '%s\n' "CODESEEQ_${key}_${suffix}"
    done
  done

  # Also forward per-model overrides for the currently configured model, so
  # arbitrary <provider>@<model> slugs (e.g. local@llama-4-maverick typed in
  # `codeseeq config`) get the same CODESEEQ_<MODEL>_* treatment as catalog
  # models. The bridge strips the "provider@" prefix the same way, so the
  # generated names must not repeat it.
  if [[ -n "${CODESEEQ_MODEL:-}" && "$CODESEEQ_MODEL" == *@* ]]; then
    local dyn_key
    # Strip the "provider@" prefix, normalize non-alnum runs to "_" and
    # trim edge separators, matching the bridge's _model_env_key().
    dyn_key="$(printf '%s' "${CODESEEQ_MODEL#*@}" | tr -c '[:alnum:]' '_' | tr '[:lower:]' '[:upper:]')"
    while [[ "$dyn_key" == _* || "$dyn_key" == *_ ]]; do
      dyn_key="${dyn_key#_}"
      dyn_key="${dyn_key%_}"
    done
    if [[ -n "$dyn_key" ]]; then
      for suffix in BASE_URL CHAT_URL TEMPERATURE TOP_P TOP_K MAX_OUTPUT_TOKENS \
                    TIMEOUT_SECONDS ENABLE_THINKING SYSTEM_PROMPT; do
        printf '%s\n' "CODESEEQ_${dyn_key}_${suffix}"
      done
    fi
  fi
}

start_bridge_container() {
  ensure_container_runtime
  ensure_image
  # Free host ports held by orphaned bridge containers from hard-killed runs
  # before picking a new port, so the auto-select range cannot be exhausted.
  bridge_reap_orphan_containers
  select_host_bridge_port

  local name="${CODESEEQ_BRIDGE_CONTAINER_NAME:-codeseeq-bridge-${CODESEEQ_OPENRESPONSES_PORT}-$$}"
  if container_exists_by_name "$name"; then
    if [[ -n "${CODESEEQ_BRIDGE_CONTAINER_NAME:-}" ]]; then
      die "bridge container name already exists: $name"
    fi
    warn "removing stale bridge container: $name"
    "$CONTAINER" rm -f "$name" >/dev/null 2>&1 || true
  fi

  # The host-side port (already auto-selected) is decoupled from the port the
  # bridge binds inside the container. A fresh container namespace always has
  # its internal port free, so mapping host==container is no longer required
  # and can never collide with a service already in the (shared) image.
  local host_port="${CODESEEQ_OPENRESPONSES_PORT}"
  local internal_port="${CODESEEQ_BRIDGE_CONTAINER_PORT:-8080}"

  local run_args=(run -d --rm --name "$name")
  if [[ "$CONTAINER" == "podman" && -n "${CODESEEQ_PODMAN_USERNS:-}" ]]; then
    run_args+=(--userns="$CODESEEQ_PODMAN_USERNS")
  fi
  run_args+=(
    -p "127.0.0.1:${host_port}:${internal_port}"
    -e CODESEEQ_OPENRESPONSES_HOST=0.0.0.0
    -e "CODESEEQ_OPENRESPONSES_PORT=${internal_port}"
  )
  local env_name
  while IFS= read -r env_name; do
    [[ -n "$env_name" ]] || continue
    if [[ -n "${!env_name:-}" ]]; then
      run_args+=(-e "$env_name")
    fi
  done < <(codeseeq_bridge_env_names)
  run_args+=(--entrypoint /usr/local/bin/codeseeq-bridge.py "$IMAGE")

  log "starting bridge container ${name} with ${CONTAINER} on ${CODESEEQ_OPENRESPONSES_URL}"
  "$CONTAINER" "${run_args[@]}" >/dev/null
  BRIDGE_CONTAINER_STARTED="$name"

  local deadline=$((SECONDS + 45))
  while (( SECONDS < deadline )); do
    if bridge_health_host; then
      return 0
    fi
    sleep 1
  done

  warn "bridge container failed to become healthy; recent logs:"
  "$CONTAINER" logs "$name" 2>&1 | tail -n 80 >&2 || true
  die "failed to start bridge container on ${CODESEEQ_OPENRESPONSES_URL}"
}

