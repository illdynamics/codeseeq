# cfg_select <prompt> <"value|label">...
# Arrow-key TUI menu rendered on the controlling terminal (/dev/tty). Prints
# the selected value to stdout (callers capture it) and returns 0, or returns
# 1 when the user quits (q / Ctrl-C). Falls back to a numbered menu on stderr
# when no controlling terminal is available (e.g. piped input).
cfg_select() {
  local prompt="$1"
  shift
  local -a vals=() labels=()
  local entry v l
  for entry in "$@"; do
    v="${entry%%|*}"
    l="${entry#*|}"
    vals+=("$v")
    labels+=("$l")
  done
  local n=${#vals[@]}
  [[ $n -gt 0 ]] || return 1

  # Use the arrow-key TUI only when stdin is a real terminal (interactive
  # use). Piped/scripted input gets the numbered fallback reading from stdin.
  # Use fixed fd 9 for the controlling terminal (bash 3.2 compatible).
  local tty_open=false
  if [[ -t 0 && -e /dev/tty ]]; then
    exec 9<>/dev/tty 2>/dev/null && tty_open=true || tty_open=false
  fi

  if [[ "$tty_open" != "true" ]]; then
    # Non-interactive fallback: numbered menu on stderr, value on stdout.
    local i choice
    echo "$prompt" >&2
    for ((i = 0; i < n; i++)); do
      printf '  %d) %s\n' "$((i + 1))" "${labels[i]}" >&2
    done
    printf 'Enter selection [1-%d]: ' "$n" >&2
    IFS= read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= n )); then
      printf '%s\n' "${vals[choice - 1]}"
      return 0
    fi
    return 1
  fi

  local sel=0 key key2
  printf '\033[?25l' >&9   # hide cursor
  while true; do
    printf '\033[H\033[J' >&9   # clear screen
    printf '\n  %s\n\n' "$prompt" >&9
    for ((i = 0; i < n; i++)); do
      if (( i == sel )); then
        printf '  \033[7m> %s\033[0m\n' "${labels[i]}" >&9
      else
        printf '    %s\n' "${labels[i]}" >&9
      fi
    done
    printf '\n  Use ↑/↓ to move, Enter to select, q to quit.\n' >&9
    IFS= read -rsn1 key <&9
    case "$key" in
      $'\x1b')
        key2=""
        IFS= read -rsn2 -t 0.1 key2 <&9 || true
        case "$key2" in
          '[A') (( sel > 0 )) && sel=$((sel - 1)) ;;
          '[B') (( sel < n - 1 )) && sel=$((sel + 1)) ;;
        esac
        ;;
      ''|$'\n'|$'\r')
        printf '\033[?25h' >&9
        exec 9>&-
        printf '%s\n' "${vals[sel]}"
        return 0
        ;;
      q|Q)
        printf '\033[?25h' >&9
        exec 9>&-
        return 1
        ;;
    esac
  done
}

# cfg_prompt <prompt> <default> -> prints input to stdout
cfg_prompt() {
  local prompt="$1" default="${2:-}"
  if [[ -n "$default" ]]; then
    printf '%s [%s]: ' "$prompt" "$default" >&2
  else
    printf '%s: ' "$prompt" >&2
  fi
  local reply=""
  IFS= read -r reply
  if [[ -z "$reply" && -n "$default" ]]; then
    reply="$default"
  fi
  printf '%s\n' "$reply"
}

# cfg_prompt_secret <prompt> -> prints input to stdout (no echo)
cfg_prompt_secret() {
  local prompt="$1"
  printf '%s: ' "$prompt" >&2
  local reply=""
  IFS= read -rs reply
  printf '\n' >&2
  printf '%s\n' "$reply"
}

# Print "value|label" lines for a provider's models from the catalog.
config_provider_model_items() {
  local provider="$1"
  local catalog
  catalog="$(config_catalog_path)"
  if [[ -f "$catalog" ]] && command -v python3 >/dev/null 2>&1; then
    local py_out=""
    if py_out="$(python3 - "$provider" "$catalog" 2>/dev/null <<'PYCFG'
import json, sys
provider, path = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as fh:
        cat = json.load(fh)
except Exception:
    sys.exit(0)
if not isinstance(cat, dict):
    sys.exit(0)
providers = cat.get("providers") if isinstance(cat.get("providers"), dict) else {}
wanted = set(providers.get(provider, {}).get("models", []) or [])
seen = set()
for m in cat.get("models", []) or []:
    if not isinstance(m, dict):
        continue
    mid = m.get("id")
    if mid not in wanted and m.get("provider") != provider:
        continue
    if mid in seen:
        continue
    seen.add(mid)
    slug = m.get("provider_model") or mid
    label = mid
    if m.get("thinking"):
        label = label + " (thinking)"
    print(f"{slug}|{label}")
PYCFG
    )" && [[ -n "$py_out" ]]; then
      printf '%s\n' "$py_out"
      return 0
    fi
  fi
  if [[ -f "$catalog" ]] && command -v jq >/dev/null 2>&1; then
    local jq_out=""
    if jq_out="$(jq -r --arg p "$provider" '(.providers[$p].models // []) as $ids | [.models[] | select((.id | IN($ids[])) or (.provider == $p))] | unique_by(.id)[] | (.provider_model // .id) + "|" + .id + (if .thinking then " (thinking)" else "" end)' "$catalog" 2>/dev/null)" && [[ -n "$jq_out" ]]; then
      printf '%s\n' "$jq_out"
      return 0
    fi
  fi
  # Static fallback (no python3/jq).
  case "$provider" in
    anthropic) printf '%s\n' "anthropic@claude-sonnet-4|claude-sonnet-4" "anthropic@claude-sonnet-4-thinking|claude-sonnet-4 (thinking)" "anthropic@claude-opus-4|claude-opus-4" "anthropic@claude-opus-4-thinking|claude-opus-4 (thinking)" "anthropic@claude-haiku-4|claude-haiku-4" ;;
    google) printf '%s\n' "google@gemini-2.5-pro|gemini-2.5-pro" "google@gemini-2.5-flash|gemini-2.5-flash" "google@gemini-2.0-flash|gemini-2.0-flash" "google@gemini-1.5-pro|gemini-1.5-pro" ;;
    grok) printf '%s\n' "grok@grok-4|grok-4" "grok@grok-4-thinking|grok-4 (thinking)" "grok@grok-3|grok-3" "grok@grok-3-thinking|grok-3 (thinking)" "grok@grok-3-mini|grok-3-mini" "grok@grok-3-mini-thinking|grok-3-mini (thinking)" "grok@grok-3-fast|grok-3-fast" "grok@grok-3-fast-thinking|grok-3-fast (thinking)" ;;
    deepseek) printf '%s\n' "deepseek@deepseek-v4-flash|deepseek-v4-flash" "deepseek@deepseek-v4-flash-thinking|deepseek-v4-flash (thinking)" "deepseek@deepseek-v4-pro|deepseek-v4-pro" "deepseek@deepseek-v4-pro-thinking|deepseek-v4-pro (thinking)" ;;
    venice) printf '%s\n' "venice@venice-qwen-3-32b|venice-qwen-3-32b" "venice@venice-qwen-3-32b-thinking|venice-qwen-3-32b (thinking)" "venice@venice-qwen-3-14b|venice-qwen-3-14b" "venice@venice-deepseek-r1-0528|venice-deepseek-r1-0528" "venice@venice-llama-3.3-70b|venice-llama-3.3-70b" "venice@venice-qwen-2.5-coder-32b|venice-qwen-2.5-coder-32b" ;;
    *) return 0 ;;
  esac
}

config_write_json() {
  # config_write_json <provider> <model> <key_env> <key> <base_url_env> <base_url>
  local provider="$1" model="$2" key_env="$3" key="$4" base_url_env="$5" base_url="$6"
  local path
  path="$(config_json_path)"
  mkdir -p "$(dirname "$path")"
  local tmp
  tmp="$(mktemp "${path}.XXXXXX")"
  local wrote=false
  if command -v python3 >/dev/null 2>&1; then
    # Read the EXISTING config from $path (argv[2]) so unrelated keys survive,
    # and write the merged result to the temp file (argv[1]); mv is atomic.
    if CODESEEQ_CONFIG_WRITE_PATH="$path" \
         CODESEEQ_CONFIG_WRITE_PROVIDER="$provider" \
         CODESEEQ_CONFIG_WRITE_MODEL="$model" \
         CODESEEQ_CONFIG_WRITE_KEY_ENV="$key_env" \
         CODESEEQ_CONFIG_WRITE_KEY="$key" \
         CODESEEQ_CONFIG_WRITE_BASE_URL_ENV="$base_url_env" \
         CODESEEQ_CONFIG_WRITE_BASE_URL="$base_url" \
         python3 - "$tmp" "$path" <<'PYCFG'
import json, os, sys
out_path, in_path = sys.argv[1], sys.argv[2]
provider = os.environ.get("CODESEEQ_CONFIG_WRITE_PROVIDER", "")
model = os.environ.get("CODESEEQ_CONFIG_WRITE_MODEL", "")
key_env = os.environ.get("CODESEEQ_CONFIG_WRITE_KEY_ENV", "")
key = os.environ.get("CODESEEQ_CONFIG_WRITE_KEY", "")
base_url_env = os.environ.get("CODESEEQ_CONFIG_WRITE_BASE_URL_ENV", "")
base_url = os.environ.get("CODESEEQ_CONFIG_WRITE_BASE_URL", "")

data = {}
try:
    with open(in_path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    data = {}
if not isinstance(data, dict):
    data = {}

# Keep unrelated keys, but clear stale provider keys when switching providers.
stale = {"ANTHROPIC_API_KEY", "GOOGLE_API_KEY", "GROK_API_KEY",
         "DEEPSEEK_API_KEY", "VENICE_API_KEY", "LOCAL_API_KEY",
         "ANTHROPIC_BASE_URL", "GOOGLE_BASE_URL", "GROK_BASE_URL",
         "DEEPSEEK_BASE_URL", "VENICE_BASE_URL", "LOCAL_BASE_URL"}
for k in stale:
    if k != key_env and k != base_url_env:
        data.pop(k, None)

data["CODESEEQ_MODEL"] = model
data["CODESEEQ_PROVIDER"] = provider
if key_env and key:
    data[key_env] = key
elif key_env:
    data.pop(key_env, None)
if base_url_env and base_url:
    data[base_url_env] = base_url
elif base_url_env:
    data.pop(base_url_env, None)

with open(out_path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
try:
    os.chmod(out_path, 0o600)
except OSError:
    pass
PYCFG
    then
      wrote=true
    fi
  fi
  if [[ "$wrote" != "true" ]] && command -v jq >/dev/null 2>&1; then
    # jq fallback (python3 missing or broken): same merge semantics.
    : > "$tmp"
    local -a jq_base=(jq -n \
      --arg provider "$provider" --arg model "$model" \
      --arg key_env "$key_env" --arg key "$key" \
      --arg base_url_env "$base_url_env" --arg base_url "$base_url")
    if [[ -f "$path" ]]; then
      if "${jq_base[@]}" --slurpfile keep "$path" '
        ($keep[0] // {})
        | del(.ANTHROPIC_API_KEY, .GOOGLE_API_KEY, .GROK_API_KEY,
              .DEEPSEEK_API_KEY, .VENICE_API_KEY, .LOCAL_API_KEY,
              .ANTHROPIC_BASE_URL, .GOOGLE_BASE_URL, .GROK_BASE_URL,
              .DEEPSEEK_BASE_URL, .VENICE_BASE_URL, .LOCAL_BASE_URL)
        | .CODESEEQ_MODEL = $model
        | .CODESEEQ_PROVIDER = $provider
        | if ($key_env != "" and $key != "") then .[$key_env] = $key else . end
        | if ($base_url_env != "" and $base_url != "") then .[$base_url_env] = $base_url else . end' \
        > "$tmp" 2>/dev/null; then
        wrote=true
      fi
    else
      if "${jq_base[@]}" '
        {CODESEEQ_MODEL: $model, CODESEEQ_PROVIDER: $provider}
        | if ($key_env != "" and $key != "") then .[$key_env] = $key else . end
        | if ($base_url_env != "" and $base_url != "") then .[$base_url_env] = $base_url else . end' \
        > "$tmp" 2>/dev/null; then
        wrote=true
      fi
    fi
  fi
  if [[ "$wrote" != "true" ]]; then
    rm -f "$tmp"
    die "config save requires a working python3 or jq (neither found)"
  fi
  mv "$tmp" "$path"
  chmod 600 "$path" 2>/dev/null || true
}

config_print_status() {
  local path
  path="$(config_json_path)"
  printf 'CodeSeeq LLM configuration\n'
  printf 'Config file: %s\n' "$path"
  if [[ ! -f "$path" ]]; then
    printf 'No config written yet. Run: codeseeq config\n'
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$path" <<'PYCFG' || true
import json, os, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    print("(unreadable config)")
    sys.exit(0)
model = data.get("CODESEEQ_MODEL", "")
provider = data.get("CODESEEQ_PROVIDER", "")
if not provider and "@" in model:
    provider = model.split("@", 1)[0]
key_envs = {"anthropic": "ANTHROPIC_API_KEY", "google": "GOOGLE_API_KEY",
            "grok": "GROK_API_KEY", "deepseek": "DEEPSEEK_API_KEY",
            "venice": "VENICE_API_KEY", "local": "LOCAL_API_KEY"}
key_env = key_envs.get(provider, "")
if provider == "local":
    key_state = "set" if data.get("LOCAL_API_KEY") else "not required (local gateway)"
else:
    key_state = "set" if (key_env and data.get(key_env)) else ("not required" if not key_env else "missing")
print(f"Provider: {provider or '(unset)'}")
print(f"Model: {model or '(unset)'}")
if key_env:
    print(f"API key ({key_env}): {key_state}")
base_envs = {"anthropic": "ANTHROPIC_BASE_URL", "google": "GOOGLE_BASE_URL",
             "grok": "GROK_BASE_URL", "deepseek": "DEEPSEEK_BASE_URL",
             "venice": "VENICE_BASE_URL", "local": "LOCAL_BASE_URL"}
base_env = base_envs.get(provider, "")
if base_env and data.get(base_env):
    print(f"Base URL: {data[base_env]}")
print("Note: an environment variable always overrides the config file value.")
PYCFG
  else
    printf 'python3 required to show config status\n'
  fi
}

config_print_help() {
  cat <<'EOF'
CodeSeeq config — configure the LLM provider, model, and API key.

Usage:
  codeseeq config          Interactive TUI (provider -> model -> API key)
  codeseeq config status   Show the current stored LLM configuration
  codeseeq config --help   Show this help

The wizard writes:
  - CODESEEQ_MODEL / CODESEEQ_PROVIDER and the provider API key into
    ~/.config/codeseeq/config.json (CODESEEQ_CONFIG_HOME/config.json).
Environment variables always override config-file values.
EOF
}

cmd_config() {
  local sub="${1:-}"
  if [[ -n "$sub" ]]; then
    case "$sub" in
      status) config_print_status; return 0 ;;
      -h|--help|help) config_print_help; return 0 ;;
      *) die "unknown config subcommand: $sub (use: status, --help)" ;;
    esac
  fi

  # ── Screen 1: provider selection ─────────────────────────────
  local -a provider_items=()
  local p
  for p in $(config_provider_list); do
    provider_items+=("$p|$(config_provider_label "$p")")
  done
  local provider=""
  provider="$(cfg_select "Select your LLM provider:" "${provider_items[@]}")" || { printf '\nConfiguration cancelled.\n' >&2; return 1; }

  # ── Screen 2: model selection ────────────────────────────────
  local model=""
  if [[ "$provider" == "local" ]]; then
    printf '\n'
    model="$(cfg_prompt "Local model name (e.g. llama-4-maverick)" "")"
    [[ -n "$model" ]] || { printf 'Model name is required.\n' >&2; return 1; }
    [[ "$model" == local@* ]] || model="local@${model}"
  else
    local -a model_items=()
    local line
    while IFS= read -r line; do
      [[ -n "$line" ]] && model_items+=("$line")
    done < <(config_provider_model_items "$provider")
    if ((${#model_items[@]} == 0)); then
      die "no models found for provider ${provider} in $(config_catalog_path)"
    fi
    model="$(cfg_select "Select a model ($(config_provider_label "$provider")):" "${model_items[@]}")" || { printf '\nConfiguration cancelled.\n' >&2; return 1; }
  fi

  # ── Screen 3: API key / endpoint ─────────────────────────────
  local key_env="" key="" base_url_env="" base_url=""
  key_env="$(config_provider_key_env "$provider")"
  base_url_env="$(config_provider_base_url_env "$provider")"
  base_url="$(config_provider_default_base_url "$provider")"
  printf '\n'
  if [[ "$provider" == "local" ]]; then
    # Local gateways: optional API key (Enter to skip), then base URL.
    key_env="LOCAL_API_KEY"
    key="$(cfg_prompt "API key (optional for local gateways, Enter to skip)" "")"
    base_url="$(cfg_prompt "Local gateway base URL" "$base_url")"
  else
    [[ -n "$key_env" ]] || die "internal error: no API-key env for provider ${provider}"
    local existing=""
    existing="$(config_json_path)"
    if command -v python3 >/dev/null 2>&1 && [[ -f "$existing" ]]; then
      existing="$(python3 - "$existing" "$key_env" 2>/dev/null <<'PYCFG'
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        data = json.load(fh)
    print(data.get(sys.argv[2], ""))
except Exception:
    print("")
PYCFG
      )" || existing=""
    else
      existing=""
    fi
    # The environment always overrides the config file at runtime, so a key
    # that is only set in the environment counts as "existing": pressing
    # Enter keeps it (and stores it in the config for completeness) instead
    # of failing with a confusing "API key is required" error.
    if [[ -z "$existing" && -n "${!key_env:-}" ]]; then
      existing="${!key_env}"
    fi
    key="$(cfg_prompt_secret "Paste your ${key_env} (Enter keeps existing${existing:+ '${existing:0:4}…'})")"
    if [[ -z "$key" ]]; then
      key="$existing"
    fi
    [[ -n "$key" ]] || { printf 'API key is required for provider %s.\n' "$provider" >&2; return 1; }
  fi

  config_write_json "$provider" "$model" "$key_env" "$key" "$base_url_env" "$base_url"

  printf '\n'
  printf 'CodeSeeq configuration saved:\n'
  printf '  Provider: %s (%s)\n' "$provider" "$(config_provider_label "$provider")"
  printf '  Model:    %s\n' "$model"
  if [[ -n "$key_env" && -n "$key" ]]; then
    printf '  API key:  %s set in %s\n' "$key_env" "$(config_json_path)"
  elif [[ "$provider" == "local" ]]; then
    printf '  API key:  none (local gateway)\n'
  fi
  if [[ -n "$base_url_env" && -n "$base_url" ]]; then
    printf '  Base URL: %s=%s\n' "$base_url_env" "$base_url"
  fi
  printf '\nCodeSeeq is ready to use. Try: codeseeq -y "hello"\n'
}


