HOST_CODEX_HOME="${CODESEEQ_HOST_CODEX_HOME:-${WORKDIR_HOST}/.codeseeq}"
HOST_CONFIG_ROOT="${XDG_CONFIG_HOME:-${HOME:-${WORKDIR_HOST}}/.config}"
CODESEEQ_CONFIG_HOME="${CODESEEQ_CONFIG_HOME:-${HOST_CONFIG_ROOT}/codeseeq}"
CONTAINER_CONFIG_HOME="${CODESEEQ_CONTAINER_CONFIG_HOME:-/home/codeseeq/.config/codeseeq}"

# Load JSON config (env vars always win); must run before the defaults below.
load_config_json

SYSTEM_PROMPT_PATH="${CODESEEQ_SYSTEM_PROMPT_FILE:-${CODESEEQ_CONFIG_HOME}/system-prompt.md}"
SYSTEM_PROMPT_CONTAINER_PATH="${CONTAINER_CONFIG_HOME}/$(basename "$SYSTEM_PROMPT_PATH")"
