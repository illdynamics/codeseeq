: "${CODESEEQ_MODEL:=deepseek-v4-flash}"
: "${CODESEEQ_THINKING:=}"
: "${CODESEEQ_REASONING_EFFORT:=}"
: "${CODESEEQ_APPROVAL_POLICY:=on-request}"
: "${CODESEEQ_SANDBOX_MODE:=workspace-write}"
: "${CODESEEQ_OPENRESPONSES_PORT:=8080}"
: "${CODESEEQ_OPENRESPONSES_PORT_SCAN_LIMIT:=100}"
: "${CODESEEQ_OPENRESPONSES_URL:=http://127.0.0.1:${CODESEEQ_OPENRESPONSES_PORT}/v1}"
: "${CODESEEQ_CONTEXT_WINDOW:=1000000}"
: "${CODESEEQ_MAX_OUTPUT_TOKENS:=384000}"
: "${CODESEEQ_REQUEST_MAX_RETRIES:=2}"
: "${CODESEEQ_STREAM_IDLE_TIMEOUT_MS:=600000}"

# --- Bridge mode configuration ---
: "${CODESEEQ_BRIDGE_MODE:=auto}"
: "${CODESEEQ_BRIDGE_HOST:=127.0.0.1}"
: "${CODESEEQ_BRIDGE_PORT:=}"
: "${CODESEEQ_BRIDGE_PORT_FILE:=}"
: "${CODESEEQ_BRIDGE_CONTAINER_PORT:=8080}"
: "${CODESEEQ_BRIDGE_BASE_URL:=}"
: "${CODESEEQ_BRIDGE_LOG:=}"
: "${CODESEEQ_BRIDGE_PID_FILE:=}"
